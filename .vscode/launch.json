{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "StockFlow: UI + Swagger",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/StockFlow.Web/bin/Debug/net10.0/StockFlow.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/StockFlow.Web",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5220",
        "StockFlow__OpenBrowserTabs": "true"
      }
    }
  ]
}
 
