{
  "schemaVersion": 1,
  "releaseScope": "Existing supported retail workflows; official provider generation and unimplemented advanced modules excluded",
  "evidenceMaxAgeHours": 24,
  "gates": [
    {
      "id": "gate-policy",
      "label": "Fail-closed release classification and evidence binding",
      "kind": "automated",
      "mandatory": true,
      "critical": true,
      "run": "powershell",
      "target": "tests/ReleaseGateChecks.ps1",
      "dependsOn": []
    },
    {
      "id": "build",
      "label": "Build test host and application",
      "kind": "automated",
      "mandatory": true,
      "critical": true,
      "run": "build",
      "target": null,
      "dependsOn": []
    },
    {
      "id": "private-shops",
      "label": "Private same-profile shops, explicit sharing, tenants and quarantined history",
      "kind": "automated",
      "mandatory": true,
      "critical": true,
      "run": "database",
      "target": "private-shop-checks",
      "dependsOn": ["build"]
    },
    {
      "id": "expenses",
      "label": "Operating expenses, payments, refunds, receipts, reports and Cash Closing",
      "kind": "automated",
      "mandatory": true,
      "critical": true,
      "run": "database",
      "target": "expense-checks",
      "dependsOn": ["build"]
    },
    {
      "id": "billing-rules",
