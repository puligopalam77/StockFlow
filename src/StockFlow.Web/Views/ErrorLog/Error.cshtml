@model string
@{
    Layout = null;
    var title = ViewData["ServiceUnavailable"] is true ? "StockFlow is temporarily unavailable" : "Unable to complete your request";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <style>
        body{margin:0;background:#f4f6fb;color:#15253f;font:16px/1.6 system-ui,sans-serif}
        main{max-width:640px;margin:10vh auto;padding:24px;background:#fff;border:1px solid #dce2ee;border-radius:12px;overflow-wrap:anywhere}
        h1{font-size:24px;line-height:1.3;margin-top:0}small{color:#52637c}
        @@media(max-width:700px){main{margin:24px 16px;padding:20px}}
    </style>
</head>
<body>
    @* Standalone fallback: no shared layout, forms, authentication, database or key-ring calls. *@
    <main>
        <h1>@title</h1>
        <p>@ViewData["ErrorMessage"]</p>
        <p>If you submitted a payment before this error, check its saved status before submitting it again.</p>
        <small>Request ID: @Model</small>
    </main>
</body>
</html>
