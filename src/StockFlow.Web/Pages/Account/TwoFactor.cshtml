@page
@model StockFlow.Web.Pages.Account.TwoFactorModel
@{ Layout = "_AuthLayout"; ViewData["Title"]="Authenticator verification"; }
<main id="main-content" class="container py-5">
    <div class="card card-body mx-auto" style="max-width:560px">
        <h1>Authenticator verification</h1>
        <div asp-validation-summary="ModelOnly" class="text-danger">
        </div>
@if(Model.RecoveryCodes.Length>0){
        <h2>Save your recovery codes</h2>
        <p>Each code works once. Store these privately; they are displayed only now.</p>
 <pre>@string.Join("\n",Model.RecoveryCodes)</pre><a class="btn btn-primary" href="/Account/Home">I saved my codes — continue</a>
}else{
 @if(!Model.Enabled){
        <p>Set up an authenticator app on your phone. It creates a code you enter when signing in.</p>
        <form method="post" asp-page-handler="Setup">
            <label asp-for="Password">Confirm your current password</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required maxlength="128"/><span asp-validation-for="Password" class="text-danger small"></span>
            <button class="btn btn-primary mt-2">Set up authenticator</button>
        </form>
 @if(Model.Secret is not null){<img src="@Model.QrDataUrl" alt="Scan this QR code with your authenticator" width="240" height="240"/>
        <p>Or enter this setup key: <code>@Model.Secret</code>
        </p>
        <p>Setup expires after 10 minutes.</p>}
 }
        <form method="post" asp-page-handler="Verify" class="mt-3">
            <label asp-for="Code">Authenticator code @(Model.Enabled?"or recovery code":"")</label>
            <input asp-for="Code" class="form-control" autocomplete="one-time-code" required maxlength="64"/><span asp-validation-for="Code" class="text-danger small"></span>
            <button class="btn btn-primary mt-2">Verify</button>
        </form>
}
        <form method="post" asp-page="/Account/Logout" class="mt-3">
            <button type="submit" class="btn btn-outline-secondary">Sign out and return to sign in</button>
        </form>
    </div>
</main>
