@page
@model StockFlow.Web.Pages.Account.ForgotPasswordModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Create new password"; }
@section Scripts { <script src="~/js/password-form.js" asp-append-version="true"></script> }
@section Styles { <link rel="stylesheet" href="~/css/password-form.css" asp-append-version="true" /> }
<main id="main-content" class="password-page">
    <section class="password-card">
        <a class="sf-brand" asp-page="/Account/Login" aria-label="StockFlow sign in"><partial name="_Brand" /></a>
        <h1>Create new password</h1>
        <p>Choose a new password and enter it again to confirm.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <label asp-for="Input.Username">Username</label>
            <input asp-for="Input.Username" class="form-control" autocomplete="username" maxlength="50" required />
            <span asp-validation-for="Input.Username" class="text-danger"></span>
            @foreach (var field in new[] { ("Password", "New password", "new-password"), ("ConfirmPassword", "Confirm password", "new-password") })
            {
                <label for="Input_@field.Item1">@field.Item2</label>
                <div class="password-control">
                    <input id="Input_@field.Item1" name="Input.@field.Item1" type="password" class="form-control" autocomplete="@field.Item3" maxlength="128" minlength="8" required />
                    <button type="button" data-password-toggle="Input_@field.Item1" aria-label="Show @field.Item2.ToLowerInvariant()" aria-pressed="false"><svg class="sf-icon" aria-hidden="true"><use href="/images/icons.svg#eye" /></svg></button>
                </div>
                @Html.ValidationMessage("Input." + field.Item1, null, new { @class = "text-danger small" })
            }
            <p class="password-rules">Use 8–128 characters. Spaces and passphrases are allowed. Avoid common or repeated passwords. Your business may require a longer minimum.</p>
            <button type="submit" class="btn btn-primary w-100">Submit</button>
        </form>
        <a asp-page="/Account/Login" class="password-back">← Back to sign in</a>
        <p class="password-help">Account verification is required to save a new password. Contact your StockFlow administrator for password recovery.</p>
    </section>
</main>
