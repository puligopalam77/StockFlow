@page
@model StockFlow.Web.Pages.Account.ChangePasswordModel
@{ ViewData["Title"]="Change password"; }
<h1>Change password</h1>
<p>Use 8–128 characters. Spaces and passphrases are allowed; your business may require a longer minimum. Sign in again after saving.</p>
<form method="post" class="card card-body" style="max-width:540px">
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>
    <label asp-for="Input.CurrentPassword">Current password</label>
    <input asp-for="Input.CurrentPassword" type="password" class="form-control mb-3" autocomplete="current-password" maxlength="128" required /><span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
    <label asp-for="Input.Password">New password</label>
    <input asp-for="Input.Password" type="password" class="form-control mb-3" autocomplete="new-password" minlength="8" maxlength="128" required /><span asp-validation-for="Input.Password" class="text-danger small"></span>
    <label asp-for="Input.ConfirmPassword">Confirm new password</label>
    <input asp-for="Input.ConfirmPassword" type="password" class="form-control mb-3" autocomplete="new-password" minlength="8" maxlength="128" required /><span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    <button class="btn btn-primary">Save password</button>
</form>

