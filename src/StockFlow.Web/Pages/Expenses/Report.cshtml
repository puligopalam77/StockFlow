@page
@{ViewData["Title"]="Expense Report";}
<div id="expenses" data-mode="report" class="expense-reports">
<header class="expense-heading"><div><h1>Expense Reports</h1><p>Review recorded expenses and balances due.</p></div><a href="/Expenses">Back to Expenses</a></header><div id="expense-message" role="alert" hidden></div>
<form id="expense-filters" class="card card-body expense-filters"><label for="expense-from">From<input id="expense-from" class="form-control" type="date" required /></label><label for="expense-to">To<input id="expense-to" class="form-control" type="date" required /></label><button class="btn btn-primary" type="submit">Apply</button><a id="expense-export" class="btn btn-outline-secondary" permission-module="EXPENSES" permission-action="EXPORT">Export CSV</a></form>
<section class="card card-body"><p id="expense-summary" role="status"></p><details class="expense-report-definition"><summary>How totals are calculated</summary><p id="expense-definition" class="expense-muted"></p></details></section>
<div class="expense-report-groups">
<section class="card card-body"><h2>Monthly Expenses</h2><div class="table-responsive"><table class="table expense-group-table"><thead><tr><th>Month</th><th>Expenses</th><th>Total Amount</th></tr></thead><tbody id="expense-report-monthly"></tbody></table></div><p id="expense-monthly-empty" class="expense-muted" hidden>No recorded expenses in this period.</p></section>
<section class="card card-body"><h2>Category-Wise Expenses</h2><div class="table-responsive"><table class="table expense-group-table"><thead><tr><th>Category</th><th>Expenses</th><th>Total Amount</th></tr></thead><tbody id="expense-report-categories"></tbody></table></div><p id="expense-categories-empty" class="expense-muted" hidden>No recorded expenses in this period.</p></section>
</div>
<section class="card card-body"><h2>Outstanding Expenses</h2><p id="expense-outstanding-note" class="expense-muted"></p><div class="table-responsive"><table class="table"><thead><tr><th>Expense Date</th><th>Payee</th><th>Category</th><th>Total Amount</th><th>Amount Paid</th><th>Balance Due</th><th>Actions</th></tr></thead><tbody id="expense-report-outstanding"></tbody></table></div><p id="expense-outstanding-empty" class="expense-muted" hidden>No outstanding expenses at this cutoff.</p></section>
<details class="card card-body expense-report-detail"><summary>Expense details in period</summary><div class="table-responsive"><table class="table"><thead><tr><th>Expense Date</th><th>Category</th><th>Payee</th><th>Amount</th><th>Paid through cutoff</th><th>Status</th><th>Actions</th></tr></thead><tbody id="expense-rows"></tbody></table></div></details>
<details class="card card-body expense-report-detail"><summary>Payment movements in period</summary><div class="table-responsive"><table class="table"><thead><tr><th>Paid Date</th><th>Expense</th><th>Type</th><th>Method</th><th>Signed Amount</th></tr></thead><tbody id="expense-report-payments"></tbody></table></div></details>
</div>
@section Scripts {<script src="~/js/expenses.js" asp-append-version="true"></script>}
@section Styles {<link rel="stylesheet" href="~/css/expenses.css" asp-append-version="true" />}
