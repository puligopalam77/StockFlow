@page
@{ViewData["Title"]="Operating Expenses";}
<div id="expenses" data-mode="list" class="sf-list-screen">
<header class="sf-page-heading"><div><h1>Operating Expenses</h1><p>Record shop overheads separately from stock purchases.</p></div><div><a class="btn btn-primary d-inline-flex align-items-center gap-2" href="/Expenses/Create" permission-module="EXPENSES" permission-action="CREATE"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><use href="/images/icons.svg#plus" /></svg><span>Add Expense</span></a> <a class="btn btn-outline-secondary" href="/Expenses/Report">Expense Report</a></div></header>
<div id="expense-message" role="alert" hidden></div>
<form id="expense-filters" class="card card-body expense-filters sf-filter-bar">
<label for="expense-term">Search<input id="expense-term" class="form-control" maxlength="150" placeholder="Category, payee or description" /></label>
<label for="expense-from">From<input id="expense-from" class="form-control" type="date" /></label><label for="expense-to">To<input id="expense-to" class="form-control" type="date" /></label>
<label for="expense-filter-category">Category<select id="expense-filter-category" class="form-select"><option value="">All categories</option></select></label>
<label for="expense-filter-payment">Payment Status<select id="expense-filter-payment" class="form-select"><option value="">All payment states</option><option value="UNPAID">Unpaid</option><option value="PARTIAL">Partially Paid</option><option value="PAID">Paid</option></select></label>
<div class="expense-filter-actions"><button class="btn btn-primary" type="submit">Apply</button><button id="expense-filter-reset" class="btn btn-outline-secondary" type="button">Reset</button></div>
<details class="expense-extra-filters"><summary>More Filters</summary><div><label for="expense-filter-payee">Payee<select id="expense-filter-payee" class="form-select"><option value="">All payees</option></select></label><label for="expense-filter-status">Expense Status<select id="expense-filter-status" class="form-select"><option value="">All states</option><option value="DRAFT">Draft</option><option value="POSTED">Recorded</option><option value="CANCELLED">Cancelled</option></select></label></div></details>
</form>
<div class="card card-body"><div class="table-responsive"><table class="table expense-list-table"><thead><tr><th>Date</th><th>Category / Description</th><th>Payee</th><th>Amount</th><th>Balance Due</th><th>Payment Status</th><th>Actions</th></tr></thead><tbody id="expense-rows"></tbody></table></div><p id="expense-list-empty" hidden>No matching expenses. Adjust the filters or create an expense.</p><div id="expense-pager"></div></div>
</div>
@section Scripts {<script src="~/js/expenses.js" asp-append-version="true"></script>}
@section Styles {<link rel="stylesheet" href="~/css/expenses.css" asp-append-version="true" />}
