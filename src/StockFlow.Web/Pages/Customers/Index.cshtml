@page "{mode?}"
@model StockFlow.Web.Pages.Customers.IndexModel
@{ ViewData["Title"] = "Customers"; }
<div id="master-data" data-module="customers" data-can-sales="@((Access.Can("SALES")).ToString().ToLowerInvariant())" data-can-edit="@(( Access.Can("CUSTOMERS","EDIT") ).ToString().ToLowerInvariant())" data-can-disable="@Access.Can("CUSTOMERS","DELETE").ToString().ToLowerInvariant()">
    @if(Access.Can("CRM")){<p><a href="/Crm" id="customer-crm-link">Customer profiles &amp; follow-ups</a></p>}
    <header class="sf-page-heading">
        <div>
            <h1>Customers</h1>
        </div>
        @if (Access.Can("CUSTOMERS","CREATE")) { <button id="add-record" class="btn btn-primary" type="button">Add customer</button> }
    </header>
    <div id="master-message" class="alert d-none" role="status" aria-live="polite">
    </div>
    <section id="editor" class="card mb-4" hidden>
        <div class="card-body">
            <h2 id="editor-title" class="h5">
            </h2>
            <form id="master-form">
                <div id="form-fields" class="row g-3">
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Save</button> <button type="button" id="cancel-edit" class="btn btn-outline-secondary">Cancel</button>
                </div>
            </form>
        </div>
    </section>
    <div class="row g-3 mb-3">
        <div class="col-md-8">
            <label for="master-search" class="form-label">Search customers</label>
            <input id="master-search" type="search" class="form-control" placeholder="Search by name or mobile" />
        </div>
        <div class="col-md-4">
            <label for="status-filter" class="form-label">Status</label>
            <select id="status-filter" class="form-select">
                <option value="false">All records</option>
                <option value="true">Active only</option>
            </select>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead id="master-head">
            </thead>
            <tbody id="master-rows">
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script src="~/js/master-data.js" asp-append-version="true"></script>
    <script src="~/js/customer.js" asp-append-version="true"></script>
}

