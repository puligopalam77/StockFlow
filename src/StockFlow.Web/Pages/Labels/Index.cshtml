@page "/Labels"
@{ ViewData["Title"] = "Barcodes"; }
@section PageHeader {
<header class="sf-page-heading"><div><h1 id="barcode-page-title">Barcodes</h1><p hidden id="barcode-page-description">Select a received lot to view its barcodes, generate missing labels, or print and reprint.</p></div><a id="barcode-back" href="/Labels" class="btn btn-outline-secondary" hidden>Back to received lots</a></header>
}
<div id="barcode-workspace" data-generate="@Access.Can("BARCODES","GENERATE").ToString().ToLowerInvariant()" data-print="@Access.Can("BARCODES","PRINT").ToString().ToLowerInvariant()" data-reprint="@Access.Can("BARCODES","REPRINT").ToString().ToLowerInvariant()">
    <div id="barcode-message" class="alert alert-danger" role="alert" hidden></div>
    <section id="barcode-lots" aria-label="Received lots">
        <div class="bc-filters bc-card"><label class="bc-search"><span class="visually-hidden">Search received lots</span><input id="barcode-lot-search" class="form-control" type="search" placeholder="Lot number, purchase order or supplier" /></label><select id="barcode-lot-kind" class="form-select" aria-label="Lot type"><option value="">All received lots</option><option value="receipt">Purchase deliveries</option><option value="intake">Received / opening stock</option></select></div>
        <div class="bc-card bc-table-wrap"><table class="table bc-table"><thead><tr><th>#</th><th>Received Lot</th><th>Date</th><th>Purchase Order</th><th>Supplier</th><th>Product Lines</th><th>Received Quantity</th><th>Barcode Status</th><th>Action</th></tr></thead><tbody id="barcode-lot-rows"></tbody></table></div>
        <div class="bc-pagination"><span id="barcode-lot-count" role="status"></span><div><button id="barcode-lot-prev" class="btn btn-outline-secondary" type="button" aria-label="Previous lots">&lsaquo;</button><span id="barcode-lot-page"></span><button id="barcode-lot-next" class="btn btn-outline-secondary" type="button" aria-label="Next lots">&rsaquo;</button></div></div>
        <a id="barcode-all-lots" href="/Labels" hidden>Show all received lots</a>
    </section>
    <section id="barcode-detail" hidden aria-label="Barcode labels for this received lot">
        <div class="bc-summary"><p id="barcode-lot-summary" class="small text-muted"></p><div class="bc-stats"><div class="bc-stat"><span class="bc-stat-icon">&#9638;</span><strong id="barcode-total">0</strong><span>Total Units</span></div><div class="bc-stat bc-stat-green"><span class="bc-stat-icon">&#9636;</span><strong id="barcode-with">0</strong><span>With Barcode</span></div><div class="bc-stat bc-stat-amber"><span class="bc-stat-icon">&#9633;</span><strong id="barcode-missing">0</strong><span>Need Barcode</span></div></div></div>
        <div class="bc-toolbar"><div class="bc-tabs" role="tablist" aria-label="Label action"><button id="barcode-print-tab" role="tab" aria-selected="true" class="active" type="button">Print Labels</button><button id="barcode-reprint-tab" role="tab" aria-selected="false" type="button">Reprint Labels</button></div><input id="barcode-row-search" type="search" class="form-control" aria-label="Search product code, SKU, barcode or serial" placeholder="Product, code, SKU, barcode or serial..." /><select id="barcode-group-mode" class="form-select bc-group-mode" aria-label="Display received units"><option value="units">Individual units</option><option value="variant">Group by variant</option></select><button id="barcode-select-all" class="btn btn-outline-secondary" type="button">Select All Eligible</button><button id="barcode-clear" class="btn btn-outline-secondary" type="button">Clear Selection</button></div>
        <div class="bc-card bc-table-wrap"><table class="table bc-table"><thead><tr><th><input id="barcode-select-page" type="checkbox" aria-label="Select eligible items on this page" /></th><th>Product / Variant</th><th>SKU</th><th>Barcode</th><th>Status</th><th>Received Qty</th><th>Copies</th><th>Action</th></tr></thead><tbody id="barcode-piece-rows"></tbody></table></div>
        <div class="bc-pagination"><span id="barcode-selection-count" role="status"></span><div><button id="barcode-piece-prev" class="btn btn-outline-secondary" type="button" aria-label="Previous items">&lsaquo;</button><span id="barcode-piece-page"></span><button id="barcode-piece-next" class="btn btn-outline-secondary" type="button" aria-label="Next items">&rsaquo;</button></div></div>
        <section class="bc-card bc-settings" aria-labelledby="barcode-settings-title"><h2 id="barcode-settings-title">&#9881; &nbsp; Print Settings</h2><div class="bc-settings-grid"><div><label for="barcode-layout" class="form-label">Paper / Label Size</label><select id="barcode-layout" class="form-select"><option value="thermal50x30">Thermal printer - 50 x 30 mm (Default)</option><option value="thermal40x25">Thermal printer - 40 x 25 mm (Small parts)</option><option value="thermal30x20">Thermal printer - 30 x 20 mm (Scan test required)</option><option value="sheet">A4 sticker sheet (Backup - choose template)</option></select><p id="barcode-paper-help" class="small text-muted mt-2 mb-0"></p><label for="barcode-printer" class="form-label mt-2">Printer</label><select id="barcode-printer" class="form-select"><option>Choose in browser print dialog</option></select></div><div><label for="barcode-default-copies" class="form-label">Default copies per label</label><div class="bc-stepper"><button id="barcode-copies-less" class="btn" type="button" aria-label="Decrease default copies">&minus;</button><input id="barcode-default-copies" type="number" min="1" max="500" step="1" value="1" aria-label="Default copies per label" /><button id="barcode-copies-more" class="btn" type="button" aria-label="Increase default copies">+</button></div><small class="text-muted">Applies to selected labels. Maximum 500 labels per batch.</small></div><div class="bc-info">Existing saved barcodes will be used. Missing codes are generated and saved before preview. Reprints always keep the same codes.</div></div><div id="barcode-small-check" class="bc-info mt-3" hidden><label><input id="barcode-small-tested" type="checkbox" /> I have successfully scan-tested a printed 30 x 20 mm label with this shop's scanner.</label><p class="mb-0">For very small packaging only. Verify the barcode scans reliably before using this size.</p></div><div id="barcode-a4-settings" class="mt-3" hidden><label for="barcode-sheet-template" class="form-label">A4 sticker template</label><select id="barcode-sheet-template" class="form-select"><option value="21">21 labels: 63 x 38 mm, 3 columns x 7 rows</option><option value="custom">Custom A4 sheet - match your sticker stock</option></select><p id="barcode-sheet-hint" class="small text-muted mt-2">Match your actual sheet: left margin 7.5 mm, top margin 15.5 mm, horizontal gap 3 mm, vertical gap 0 mm. Print at 100% scale.</p><div id="barcode-template-fields" class="bc-template-fields" hidden><label>Label width (mm)<input id="barcode-sheet-width" class="form-control" type="number" min="0" step="0.1" value="63" /></label><label>Label height (mm)<input id="barcode-sheet-height" class="form-control" type="number" min="0" step="0.1" value="38" /></label><label>Columns<input id="barcode-sheet-columns" class="form-control" type="number" min="0" step="1" value="3" /></label><label>Rows<input id="barcode-sheet-rows" class="form-control" type="number" min="0" step="1" value="7" /></label><label>Left margin (mm)<input id="barcode-sheet-left" class="form-control" type="number" min="0" step="0.1" value="7.5" /></label><label>Top margin (mm)<input id="barcode-sheet-top" class="form-control" type="number" min="0" step="0.1" value="15.5" /></label><label>Horizontal gap (mm)<input id="barcode-sheet-column-gap" class="form-control" type="number" min="0" step="0.1" value="3" /></label><label>Vertical gap (mm)<input id="barcode-sheet-row-gap" class="form-control" type="number" min="0" step="0.1" value="0" /></label></div></div><div class="bc-actions"><button id="barcode-reprint-open" class="btn btn-outline-secondary" type="button" hidden>Choose labels to reprint</button><button id="barcode-preview" class="btn btn-outline-primary" type="button" disabled>Preview Selected</button><button id="barcode-print" class="btn btn-primary" type="button" disabled>Print Labels</button></div></section>
        <section class="bc-card bc-history" aria-labelledby="barcode-history-title"><div class="bc-history-heading"><h2 id="barcode-history-title">Print Request History</h2><button id="barcode-history-all" class="btn btn-link" type="button">View all</button></div><p class="small text-muted">Requests sent to the browser print dialog. Physical printing is not confirmed.</p><div class="bc-table-wrap"><table class="table bc-table"><thead><tr><th>#</th><th>Barcode</th><th>Product / Variant</th><th>Requested On</th><th>Requested By</th><th>Copies</th><th>Format</th></tr></thead><tbody id="barcode-history-rows"></tbody></table></div></section>
    </section>
    <dialog id="barcode-preview-dialog" class="bc-dialog" aria-labelledby="barcode-preview-title"><div class="bc-dialog-heading"><div><h2 id="barcode-preview-title">Label Preview</h2><p id="barcode-preview-summary" class="text-muted small"></p></div><button class="bc-close" type="button" data-close="barcode-preview-dialog" aria-label="Close label preview">&times;</button></div><p id="barcode-preview-error" class="alert alert-danger" role="alert" hidden></p><div id="label-preview-area" class="label-sheet" aria-label="Label preview"></div><footer class="bc-dialog-footer"><div class="bc-info">Print opens your browser printer dialog. Match the printer paper to the selected size, use 100% scale, and turn headers and footers off.</div><button class="btn btn-outline-secondary" data-close="barcode-preview-dialog" type="button">Cancel</button><button id="barcode-preview-print" type="button" class="btn btn-primary">Print</button></footer></dialog>
    <dialog id="barcode-reprint-dialog" class="bc-dialog" aria-labelledby="barcode-reprint-title"><div class="bc-dialog-heading"><div><h2 id="barcode-reprint-title">Reprint Labels</h2><p class="small text-muted">Select labels with a previous print request to reuse their saved codes.</p></div><button class="bc-close" type="button" data-close="barcode-reprint-dialog" aria-label="Close reprint labels">&times;</button></div><p id="barcode-reprint-error" class="alert alert-danger" role="alert" hidden></p><input id="barcode-reprint-search" class="form-control mb-3" type="search" aria-label="Search previously requested labels" placeholder="Search barcode or product..." /><div class="bc-table-wrap"><table class="table bc-table"><thead><tr><th><input id="barcode-reprint-all" type="checkbox" aria-label="Select all previously requested labels" /></th><th>Product / Variant</th><th>Barcode</th><th>Last Requested</th><th>Requested By</th><th>Action</th></tr></thead><tbody id="barcode-reprint-rows"></tbody></table></div><footer class="bc-dialog-footer"><strong id="barcode-reprint-count"></strong><label class="small">Copies per label <input id="barcode-reprint-copies" class="bc-copies" type="number" min="1" max="500" step="1" value="1" aria-label="Copies per reprint label" /></label><button class="btn btn-outline-secondary" data-close="barcode-reprint-dialog" type="button">Cancel</button><button id="barcode-reprint-selected" class="btn btn-primary" type="button" disabled>Reprint Selected</button></footer></dialog>
</div>
@section Styles {<link rel="stylesheet" href="~/css/barcode-management.css" asp-append-version="true" />}
@section Scripts {<script src="~/js/common/barcode-labels.js" asp-append-version="true"></script><script src="~/js/barcode-management.js" asp-append-version="true"></script>}
