@page
@model StockFlow.Web.Pages.Notifications.IndexModel
@{ ViewData["Title"]="Notifications"; }
@section PageHeader { <h1>Notifications</h1> }
@if(!Model.Ready) { <div class="alert alert-info">Notifications are awaiting database setup.</div> }
else {
 <div class="d-flex justify-content-between align-items-center mb-2"><span>@Model.Feed.Unread unread</span><form method="post" asp-page-handler="Read"><input type="hidden" asp-for="PageNumber" /><input type="hidden" asp-for="PageSize" /><button class="btn btn-outline-primary" disabled="@(Model.Feed.Unread==0)">Mark all as read</button></form></div>
 <div class="sf-notification-history">
 @foreach(var item in Model.Feed.Items) {
 <article class="sf-notification-item @(item.ReadAt is null ? "unread" : "")"><div><strong>@item.Title</strong><p>@item.Body</p><time>@item.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</time></div>
 <div class="d-flex gap-2 align-items-center"><a href="@item.Url" class="btn btn-outline-primary">View</a>@if(item.ReadAt is null) { <form method="post" asp-page-handler="Read"><input type="hidden" name="PageNumber" value="@Model.PageNumber" /><input type="hidden" name="PageSize" value="@Model.PageSize" /><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-outline-secondary">Mark read</button></form> }</div></article>
 }
 @if(Model.Feed.Items.Count==0) { <p class="p-3">No notifications yet.</p> }
 </div><nav id="notification-pagination" data-sf-pagination-link data-page="@Model.PageNumber" data-size="@Model.PageSize" data-total="@Model.Feed.Total" aria-label="Notification pages">@if(Model.PageNumber>1) { <a asp-route-PageNumber="@(Model.PageNumber-1)" asp-route-PageSize="@Model.PageSize">Previous</a> } @if((long)Model.PageNumber*Model.PageSize<Model.Feed.Total) { <a asp-route-PageNumber="@(Model.PageNumber+1)" asp-route-PageSize="@Model.PageSize">Next</a> }</nav>
}
