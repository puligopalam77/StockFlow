@page
@{ ViewData["Title"] = "E-Way preparation"; }
<div id="eway-workspace">
<header class="sf-page-heading"><div><h1>E-Way preparation</h1><p id="eway-heading">Select an actual movement source. This screen does not submit to the government.</p></div><a href="/EWayBills" class="btn btn-outline-secondary">Back to register</a></header>
<div id="eway-message" class="alert alert-danger" role="alert" hidden></div>
<section id="eway-source-section" class="card card-body mb-3"><h2>1. Source document</h2><p class="small">Sales: issued GST invoice snapshots. Purchases: separately recorded supplier tax invoices, not purchase orders/receipts. Transfers: approved outward movement linked to an actual delivery challan; no artificial sale.</p>
<form id="eway-source-search" class="eway-grid"><label>Source type<select id="eway-source-type" class="form-select"><option value="GST">Recorded GST invoice</option><option value="TRANSFER">Outward stock transfer</option></select></label><label>Source number / party<input id="eway-source-term" class="form-control" maxlength="100" /></label><button class="btn btn-outline-secondary">Search sources</button></form><div id="eway-sources" class="mt-2"></div><div class="d-flex gap-2"><button id="eway-source-prev" type="button" class="btn btn-sm btn-outline-secondary">Previous</button><span id="eway-source-page"></span><button id="eway-source-next" type="button" class="btn btn-sm btn-outline-secondary">Next</button></div></section>
<form id="eway-form" hidden>
<section class="card card-body mb-3"><h2>2. Document &amp; movement</h2><div class="eway-grid"><label>Document type<select name="documentType" class="form-select"><option value="INV">Tax invoice</option><option value="BIL">Bill of supply</option><option value="CHL">Delivery challan</option><option value="BOE">Bill of entry</option><option value="OTH">Other (review required)</option></select></label><label>Actual document number<input name="movementDocumentNumber" class="form-control" maxlength="100" /></label><label>Actual document date<input name="movementDocumentDate" type="date" class="form-control" /></label><label>Movement reason / official subtype review<input name="movementReason" class="form-control" maxlength="500" /></label><label>Transaction arrangement<select name="transactionType" class="form-select"><option value="1">Regular</option><option value="2">Bill to / ship to</option><option value="3">Bill from / dispatch from</option><option value="4">Both arrangements</option></select></label></div></section>
<section class="card card-body mb-3"><h2>3. Parties &amp; actual addresses</h2><p class="small">Missing information stays blank. Enter URP explicitly for an unregistered party. Advanced bill/dispatch/ship arrangements preserve each actual address.</p><div class="eway-parties">
@foreach(var party in new[]{("billFrom","Bill from"),("dispatchFrom","Dispatch from"),("billTo","Bill to"),("shipTo","Ship to")}){
<fieldset data-party="@party.Item1"><legend>@party.Item2</legend><label>Name<input data-field="name" class="form-control" maxlength="200" /></label><label>GSTIN or URP<input data-field="gstin" class="form-control" maxlength="15" /></label><label>Address<textarea data-field="address" class="form-control" maxlength="1000" rows="2"></textarea></label><label>State<select data-field="state" class="form-select"><option value="">Choose actual state</option></select></label><label>PIN<input data-field="pin" class="form-control" inputmode="numeric" maxlength="6" /></label></fieldset>
}</div></section>
<section class="card card-body mb-3"><h2>4. Goods &amp; source values</h2><p class="small">Issued GST goods and values are read from immutable snapshots; current catalog prices are not used. Unknown transfer value is not zero.</p><div id="eway-goods" class="table-responsive"></div><div id="eway-transfer-goods" hidden><label>Actual challan evidence reference<input name="goodsEvidence" class="form-control" maxlength="1000" /></label><div class="table-responsive"><table class="table"><thead><tr><th>Description</th><th>HSN</th><th>Quantity</th><th>UQC</th><th>Taxable value</th><th>CGST</th><th>SGST</th><th>UTGST</th><th>IGST</th><th>Cess</th><th></th></tr></thead><tbody id="eway-transfer-lines"></tbody></table></div><button id="eway-add-line" type="button" class="btn btn-outline-secondary">Add actual challan goods</button></div></section>
<section class="card card-body mb-3"><h2>5. Transportation &amp; review</h2><div class="eway-grid"><label>Mode<select name="mode" class="form-select"><option value="ROAD">Road</option><option value="RAIL">Rail</option><option value="AIR">Air</option><option value="SHIP">Ship</option><option value="PART_A">Part A preparation only</option></select></label><label>Distance (km)<input name="distanceKm" type="number" min="0" max="4000" class="form-control" /></label><label>Transporter name<input name="transporterName" class="form-control" maxlength="200" /></label><label>Transporter ID / GSTIN<input name="transporterId" class="form-control" maxlength="15" /></label><label id="eway-vehicle-label">Vehicle number<input name="vehicle" class="form-control" maxlength="15" /></label><label id="eway-transport-doc-label">Transport document<input name="transportDocument" class="form-control" maxlength="100" /></label><label id="eway-transport-date-label">Transport document date<input name="transportDocumentDate" type="date" class="form-control" /></label></div><label>Authorized applicability review (state/movement/exemptions; not a value-only decision)<textarea name="applicabilityReview" class="form-control" maxlength="1000" rows="2"></textarea></label>
<p id="eway-state" class="mt-2" role="status"></p><div class="d-flex flex-wrap gap-2"><button id="eway-save" class="btn btn-primary" type="submit">Save preparation</button><button id="eway-validate" class="btn btn-outline-secondary" type="button" hidden>Check saved preparation</button><button id="eway-export" class="btn btn-outline-secondary" type="button" hidden>Download worksheet CSV</button><button id="eway-print" class="btn btn-outline-secondary" type="button" hidden>Print saved worksheet</button><a id="eway-portal" class="btn btn-outline-secondary" href="https://ewaybillgst.gov.in/" target="_blank" rel="noopener noreferrer">Open government portal</a></div><p class="small">Portal login/submission is performed by the authorized user. The worksheet is not an upload-ready government JSON file. API generation, cancellation, transport updates and extensions are unavailable without the verified provider integration.</p><ul id="eway-validation"></ul></section>
</form>
<section id="eway-external" class="card card-body mb-3" hidden><h2>External portal reference</h2><p>Record only after checking actual portal evidence. This remains unverified by StockFlow and does not confirm official validity or cancellation.</p><label>External EBN<input id="eway-ebn" class="form-control" inputmode="numeric" maxlength="12" /></label><label>Evidence reference, checked date and reviewer<textarea id="eway-evidence" class="form-control" maxlength="1000" rows="2"></textarea></label><button id="eway-record" class="btn btn-primary" type="button">Record as unverified</button></section>
<section class="eway-print-only"><h2>Saved preparation worksheet — not an official e-way bill</h2><div id="eway-print-snapshot"></div></section>
<details id="eway-history-section" class="card card-body" hidden><summary>Revision &amp; action history</summary><div id="eway-history"></div></details>
</div>
@section Scripts {<script src="~/js/sales-common.js" asp-append-version="true"></script><script src="~/js/ewaybills.js" asp-append-version="true"></script>}
@section Styles {<link rel="stylesheet" href="~/css/ewaybills.css" asp-append-version="true" />}
