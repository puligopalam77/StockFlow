@page
@inject StockFlow.Application.Common.BusinessScope Scope
@{ ViewData["Title"] = "E-Way Bills"; }
<div id="eway-workspace">
<header class="sf-page-heading"><div><h1>E-Way Bills</h1><p>@Scope.LocationName · Preparation and portal evidence</p></div><a class="btn btn-dark" href="/EWayBills/Prepare" permission-module="EWAY_BILLS" permission-action="PREPARE">Prepare movement</a></header>
<p class="small">No StockFlow monthly numeric quota. Automatic generation is unavailable until an authorized provider integration is verified. An exported worksheet is not a government submission.</p>
<div id="eway-message" class="alert alert-danger" role="alert" hidden></div>
<form id="eway-filters" class="eway-grid card card-body"><label>Search<input id="eway-term" class="form-control" maxlength="100" placeholder="EBN, source number or party" /></label><label>Status<select id="eway-status" class="form-select"><option value="">All</option><option value="DRAFT">Not generated</option><option value="EXTERNAL_UNVERIFIED">External EBN — unverified</option></select></label><label>Source type<select id="eway-sourceType" class="form-select"><option value="">All</option><option value="GST">Recorded GST invoice</option><option value="TRANSFER">Stock transfer</option></select></label><label>Registration<select id="eway-registrationId" class="form-select"><option value="">All mapped registrations</option></select></label><label>Created from<input id="eway-from" class="form-control" type="date" /></label><label>Created to<input id="eway-to" class="form-control" type="date" /></label><button class="btn btn-dark">Apply</button></form>
<div class="card card-body mt-3"><div class="table-responsive"><table class="table"><thead><tr><th>EBN</th><th>Source / date</th><th>Recipient</th><th>From → To / mode</th><th>Consignment value</th><th>Status</th><th>Official validity</th><th>Actions</th></tr></thead><tbody id="eway-rows"></tbody></table></div><div class="d-flex justify-content-between"><button id="eway-prev" class="btn btn-outline-secondary">Previous</button><span id="eway-page" role="status"></span><button id="eway-next" class="btn btn-outline-secondary">Next</button></div></div>
<details class="card card-body mt-3" permission-module="EWAY_BILLS" permission-action="VIEW_USAGE"><summary>Usage and costs</summary><p>Local preparation actions are separate from provider requests and official generations.</p><label>From<input id="usage-from" type="date" class="form-control" /></label><label>To<input id="usage-to" type="date" class="form-control" /></label><button id="eway-usage" type="button" class="btn btn-outline-secondary">Load usage</button><pre id="eway-usage-result"></pre></details>
</div>
@section Scripts {<script src="~/js/sales-common.js" asp-append-version="true"></script><script src="~/js/ewaybills.js" asp-append-version="true"></script>}
@section Styles {<link rel="stylesheet" href="~/css/ewaybills.css" asp-append-version="true" />}
