@page
@model StockFlow.Web.Pages.Warranty.ClaimsModel
@{ ViewData["Title"] = "Warranty claims"; }
<h1>Warranty claims</h1>
<div id="warranty-message" class="alert alert-danger" role="alert" hidden>
</div>
<label for="claim-filter" class="form-label">Status</label>
<select id="claim-filter" class="form-select mb-3">
    <option value="" data-i18n>All statuses</option>
    <option value="OPEN" data-i18n>Open</option>
    <option value="UNDER_REVIEW" data-i18n>Under review</option>
    <option value="APPROVED" data-i18n>Approved</option>
    <option value="REJECTED" data-i18n>Rejected</option>
    <option value="REPLACED" data-i18n>Replaced</option>
    <option value="CLOSED" data-i18n>Closed</option>
</select>
<div id="claim-results" aria-live="polite">
</div>
<button id="previous" class="btn btn-secondary" disabled>Previous</button>
<button id="next" class="btn btn-secondary" disabled>Next</button>
@section Scripts {
    <script src="~/js/warranty-common.js" asp-append-version="true"></script>
    <script src="~/js/warranty-claims.js" asp-append-version="true"></script>
}
