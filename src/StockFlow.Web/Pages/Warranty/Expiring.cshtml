@page
@model StockFlow.Web.Pages.Warranty.ExpiringModel
@{ ViewData["Title"] = "Expiring warranties"; }
<h1>Expiring warranties</h1>
<div id="warranty-message" class="alert alert-danger" role="alert" hidden>
</div>
<label for="expiry-days" class="form-label">Expiry within</label>
<select id="expiry-days" class="form-select mb-3">
    <option value="7">7 days</option>
    <option value="30" selected>30 days</option>
    <option value="60">60 days</option>
    <option value="90">90 days</option>
</select>
<div id="warranty-results" aria-live="polite">
</div>
<button id="previous" class="btn btn-secondary" disabled>Previous</button>
<button id="next" class="btn btn-secondary" disabled>Next</button>
@section Scripts {
    <script src="~/js/warranty-common.js" asp-append-version="true"></script>
    <script src="~/js/warranty-expiring.js" asp-append-version="true"></script>
}
