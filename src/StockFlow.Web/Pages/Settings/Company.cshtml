@page
@model StockFlow.Web.Pages.Settings.CompanyModel
@{ ViewData["Title"] = Model.Title; ViewData["CompanySection"] = Model.Section; }
<div id="company-settings-workspace" data-section="@Model.Section" data-validation-failed="@((!ViewData.ModelState.IsValid).ToString().ToLowerInvariant())" data-edit="@Access.Can("COMPANY_SETTINGS","EDIT").ToString().ToLowerInvariant()">
<header class="sf-page-heading company-page-heading"><div><h1 tabindex="-1" id="company-view-title">@Model.Title</h1></div></header>
<p class="company-scope">@(Model.IsBusiness?"Business identity, address, contact details and branding apply to this company and all its branches.":"Billing defaults and print messages apply to this company and all its branches. Billing Discount Policy is saved separately for the active shop.")</p>
@if(Model.Message is not null){<div class="alert alert-success" role="status">@Model.Message</div>}
<form method="post" enctype="multipart/form-data" id="company-settings-form" class="company-settings-form" asp-route-section="@Model.Section" data-unsaved-context="@Model.Title">
<input asp-for="EditVersion" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<fieldset class="company-edit-fields" disabled="@(!Access.Can("COMPANY_SETTINGS","EDIT"))">
@if(Model.IsBusiness){
<section class="company-settings-card business" id="company-business-information">
<header><span class="company-step" aria-hidden="true">1</span><div><h2>Business Information</h2><p>Manage the details displayed on customer bills and business documents.</p></div></header>
<div class="company-card-body">
<h3>Business identity</h3>
<div class="company-identity-layout"><div class="company-settings-grid">
<div class="company-field"><label asp-for="Input.CompanyName">Company / shop display name *</label><input asp-for="Input.CompanyName" class="form-control" maxlength="150" required /><span asp-validation-for="Input.CompanyName" class="text-danger"></span></div>
<div class="company-field"><label asp-for="Input.LegalBusinessName">Company legal name (fallback)</label><input asp-for="Input.LegalBusinessName" class="form-control" maxlength="150" /><span asp-validation-for="Input.LegalBusinessName" class="text-danger"></span></div>
<p class="company-full company-help">These company display details do not change GST legal businesses or registrations.</p>
</div><div class="company-logo-field"><h3>Business logo</h3><div class="company-logo-controls"><div class="company-logo-preview"><img id="company-logo-preview" src="@Model.Input.LogoDataUrl" alt="Business logo" hidden="@(Model.Input.LogoDataUrl is null)" /><span id="company-logo-empty" hidden="@(Model.Input.LogoDataUrl is not null)">No logo selected</span></div><div><button type="button" id="company-logo-choose" class="btn btn-outline-secondary">Change logo</button><input aria-label="Choose business logo" tabindex="-1" asp-for="LogoUpload" type="file" accept="image/png,image/jpeg" class="visually-hidden" /><input asp-for="RemoveLogo" type="hidden" /><button type="button" id="company-logo-remove" class="btn btn-outline-secondary">Remove</button><small>PNG or JPG, up to 2 MB. Recommended: 300 &times; 300 px. Preview changes are saved with company details.</small><span asp-validation-for="LogoUpload" class="text-danger"></span></div></div></div></div>
<section class="company-tax-identity" aria-labelledby="company-tax-heading"><h3 id="company-tax-heading">GST identity for the active shop</h3>
@if(Model.GstIdentity is {} gst){<dl class="company-identity-summary"><div><dt>Legal business</dt><dd>@gst.LegalName</dd></div><div><dt>GST registration</dt><dd>@(gst.Gstin??"Not GST registered") &middot; @gst.RegistrationType</dd></div><div><dt>PAN</dt><dd>@(gst.Pan??"Not recorded")</dd></div><div><dt>Applies to</dt><dd>@gst.StoreName / @gst.Profile</dd></div></dl><p class="company-help">This effective registration is authoritative for GST invoicing. Local configuration does not verify GST Portal status.</p>}
else{<p class="company-help">No effective GST identity is displayed here. GST Setup determines the registration used for mapped shops; company fallback values cannot override it. Review mapping dates and permissions in GST Settings when applicable.</p>}
@if(Access.Can("GST_SETTINGS","VIEW")){<a href="/Admin/Gst" class="btn btn-outline-secondary">Manage GST Settings</a>}
<details open="@(!ViewData.ModelState.IsValid)"><summary>Legacy company tax display fields</summary><p class="company-help">Retained for compatible company documents and unmapped billing. These fields do not update GST Setup or historical invoices.</p><div class="company-settings-grid"><div class="company-field"><label asp-for="Input.GstNumber">Company GST number (legacy)</label><input asp-for="Input.GstNumber" class="form-control" maxlength="15" /><span asp-validation-for="Input.GstNumber" class="text-danger"></span></div><div class="company-field"><label asp-for="Input.PanNumber">Company PAN (optional)</label><input asp-for="Input.PanNumber" class="form-control" maxlength="10" /><span asp-validation-for="Input.PanNumber" class="text-danger"></span></div></div></details>
</section>
<h3>Business address</h3><p class="company-help">Retain the saved combined address, or explicitly enter structured address details. City, state and PIN print separately on company documents.</p>
<input asp-for="UseStructuredAddress" type="hidden" />
<div id="company-legacy-address" hidden="@Model.UseStructuredAddress">
<div class="company-field"><label asp-for="Input.Address">Saved combined address *</label><textarea asp-for="Input.Address" class="form-control" rows="2" maxlength="2000" required disabled="@Model.UseStructuredAddress"></textarea><span asp-validation-for="Input.Address" class="text-danger"></span></div>
<button type="button" id="company-structure-address" class="btn btn-outline-secondary">Enter structured address</button>
</div>
@if(!string.IsNullOrWhiteSpace(Model.Input.Address)){<p class="company-legacy-review">Saved address for reference: @Model.Input.Address</p>}
<div id="company-structured-address" class="company-settings-grid" hidden="@(!Model.UseStructuredAddress)">
<div class="company-full"><div class="company-field"><label asp-for="Input.AddressLine1">Address Line 1 *</label><input asp-for="Input.AddressLine1" class="form-control" maxlength="250" placeholder="Building, premises and street" disabled="@(!Model.UseStructuredAddress)" required="@Model.UseStructuredAddress" /><span asp-validation-for="Input.AddressLine1" class="text-danger"></span></div></div>
<div class="company-full"><div class="company-field"><label asp-for="Input.AddressLine2">Address Line 2 (optional)</label><input asp-for="Input.AddressLine2" class="form-control" maxlength="250" placeholder="Area, locality or landmark" disabled="@(!Model.UseStructuredAddress)" /><span asp-validation-for="Input.AddressLine2" class="text-danger"></span></div></div>
</div>
<div class="company-settings-grid company-address-locality">
<div class="company-field"><label asp-for="Input.City">City / Town *</label><input asp-for="Input.City" class="form-control" maxlength="100" required /><span asp-validation-for="Input.City" class="text-danger"></span></div>
<div class="company-field"><label asp-for="Input.State">State / Union Territory *</label><select asp-for="Input.State" class="form-select" required><option value="">Choose state / UT</option>@foreach(var state in StockFlow.Application.Common.GstRules.States.Where(s=>s.Key!="28").Select(s=>s.Value).Order()){<option value="@state">@state</option>}@if(!string.IsNullOrWhiteSpace(Model.Input.State)&&!StockFlow.Application.Common.GstRules.States.Where(s=>s.Key!="28").Select(s=>s.Value).Contains(Model.Input.State)){<option value="@Model.Input.State">@Model.Input.State (saved value)</option>}</select><span asp-validation-for="Input.State" class="text-danger"></span></div>
<div id="company-district-field" hidden="@(!Model.UseStructuredAddress)"><div class="company-field"><label asp-for="Input.District">District (optional)</label><input asp-for="Input.District" class="form-control" maxlength="100" disabled="@(!Model.UseStructuredAddress)" /><span asp-validation-for="Input.District" class="text-danger"></span></div></div>
<div class="company-field"><label asp-for="Input.PinCode">PIN code *</label><input asp-for="Input.PinCode" class="form-control" type="text" inputmode="numeric" autocomplete="postal-code" pattern="[1-9][0-9]{5}" maxlength="6" required /><span asp-validation-for="Input.PinCode" class="text-danger"></span></div>
</div>
<h3>Contact details</h3><div class="company-settings-grid">
<div class="company-field"><label asp-for="Input.MobileNumber">Phone *</label><input asp-for="Input.MobileNumber" class="form-control" type="tel" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" required /><span asp-validation-for="Input.MobileNumber" class="text-danger"></span></div>
<div class="company-field"><label asp-for="Input.AlternatePhone">Alternate phone (optional)</label><input asp-for="Input.AlternatePhone" class="form-control" type="tel" pattern="[0-9]{10}" maxlength="10" /><span asp-validation-for="Input.AlternatePhone" class="text-danger"></span></div>
<div class="company-field"><label asp-for="Input.Email">Email *</label><input asp-for="Input.Email" class="form-control" type="email" maxlength="150" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
<div class="company-field"><label asp-for="Input.Website">Website (optional)</label><input asp-for="Input.Website" class="form-control" type="url" maxlength="250" /><span asp-validation-for="Input.Website" class="text-danger"></span></div>
</div></div></section>
}
@if(!Model.IsBusiness){
<section class="company-settings-card billing" id="company-billing-settings"><header><span class="company-step" aria-hidden="true">2</span><div><h2>Billing Configuration</h2><p>Set defaults for eligible new invoices and receipts.</p></div></header><div class="company-card-body">
<h3>Document numbering</h3><div class="company-settings-grid">
<div class="company-field"><label asp-for="Input.InvoicePrefix">Invoice prefix *</label><input asp-for="Input.InvoicePrefix" class="form-control" maxlength="30" pattern="[A-Za-z0-9_\{\}\-]+" required /><span asp-validation-for="Input.InvoicePrefix" class="text-danger"></span></div>
<div class="company-field"><label asp-for="Input.ReceiptPrefix">Receipt prefix *</label><input asp-for="Input.ReceiptPrefix" class="form-control" maxlength="30" pattern="[A-Za-z0-9_\{\}\-]+" required /><span asp-validation-for="Input.ReceiptPrefix" class="text-danger"></span></div>
</div><p class="company-help">Use {YYYY} for the current year. Prefix changes affect future documents; issued numbers and sequences are retained.</p><p id="company-number-preview" class="company-number-preview"></p>
<h3>Billing defaults</h3><div class="company-settings-grid">
<div class="company-field"><label asp-for="Input.Currency">Currency *</label><select asp-for="Input.Currency" class="form-select" required><option value="INR">INR (&#8377;)</option></select><span asp-validation-for="Input.Currency" class="text-danger"></span></div>
<div class="company-field"><label asp-for="Input.DefaultTaxMode">Default tax mode *</label><select asp-for="Input.DefaultTaxMode" class="form-select" required><option value="EXCLUSIVE">Tax exclusive</option><option value="INCLUSIVE">Tax inclusive</option></select><span asp-validation-for="Input.DefaultTaxMode" class="text-danger"></span></div>
<div class="company-field"><label asp-for="Input.DefaultPaymentTermsDays">Default payment terms (optional)</label><select asp-for="Input.DefaultPaymentTermsDays" class="form-select" ><option value="">No default</option><option value="0">Due on receipt</option>@foreach(var days in new[]{7,15,30,60,90}.Concat(Model.Input.DefaultPaymentTermsDays is {} savedDays?new[]{savedDays}:Array.Empty<int>()).Distinct().Where(d=>d>0).Order()){<option value="@days">@days days</option>}</select><span asp-validation-for="Input.DefaultPaymentTermsDays" class="text-danger"></span></div>
<div class="company-field"><label asp-for="Input.DefaultSalespersonId">Default salesperson (optional)</label><select asp-for="Input.DefaultSalespersonId" class="form-select" ><option value="">Signed-in staff member</option>@foreach(var person in Model.Salespeople){<option value="@person.UserId">@person.FullName</option>}</select><span asp-validation-for="Input.DefaultSalespersonId" class="text-danger"></span></div>
</div><p class="company-help">Tax mode applies to future eligible bills. Payment terms remain a compatibility default; they do not enable new credit or split-payment checkout. Staff defaults use the authorized company staff list.</p></div></section>
<section class="company-settings-card printing"><header><span class="company-step" aria-hidden="true">3</span><div><h2>Invoice Printing</h2><p>Customize customer-facing bill messages without changing the invoice theme.</p></div></header><div class="company-card-body"><div class="company-settings-grid">
<div class="company-field"><label asp-for="Input.InvoiceFooter">Message printed at the bottom of bills</label><textarea asp-for="Input.InvoiceFooter" class="form-control" rows="3" maxlength="250" aria-describedby="invoice-footer-count"></textarea><span asp-validation-for="Input.InvoiceFooter" class="text-danger"></span></div><small id="invoice-footer-count" class="company-character-count company-sr-count"></small>
<div class="company-field"><label asp-for="Input.TermsAndConditions">Terms &amp; conditions (optional)</label><textarea asp-for="Input.TermsAndConditions" class="form-control" rows="3" maxlength="500" aria-describedby="company-terms-count"></textarea><span asp-validation-for="Input.TermsAndConditions" class="text-danger"></span></div><small id="company-terms-count" class="company-character-count company-sr-count"></small>
</div><section class="company-footer-preview" aria-labelledby="company-footer-preview-heading"><h3 id="company-footer-preview-heading">Bill footer text preview</h3><p id="company-preview-state" class="company-help" role="status"></p><p id="company-footer-preview-text"></p><p id="company-terms-preview-text"></p><small>Text-only preview. A4 and thermal layouts, totals and GST calculations keep their existing behavior.</small></section></div></section>
}
<div class="company-settings-actions">@if(!Model.IsBusiness){<div><button type="button" id="company-reset-defaults" class="btn btn-outline-secondary" title="Reset unsaved billing and printing values only. Save Billing Settings to apply.">Reset billing &amp; printing defaults</button><small>Business identity, address, logo and discount policy are retained.</small></div>}<button permission-module="COMPANY_SETTINGS" permission-action="EDIT" id="company-settings-save" class="btn btn-primary" type="submit">@(Model.IsBusiness?"Save Business Information":"Save Billing Settings")</button></div>
</fieldset></form>
@if(!Model.IsBusiness && Access.Can("COMPANY_SETTINGS","EDIT")){
<section class="company-settings-card policy" id="billing-policy-settings"><header><span class="company-step" aria-hidden="true">4</span><div><h2>Billing Discount Policy</h2><p>Control routine checkout discounts and exceptional approvals.</p></div></header><div class="company-card-body">
<p class="company-help">Scope: active shop, across its profiles and locations. Saved independently from company details. The policy is rechecked when checkout completes.</p>
<div id="billing-policy-message" class="alert" role="status" data-keep-banner hidden></div>
<form id="billing-policy-form" data-unsaved-context="Active shop billing discount policy">
<p id="billing-policy-state" class="company-policy-state" role="status">Loading saved policy...</p>
<div class="company-field company-policy-limit"><label for="discount-limit-percent">Discount above this percentage requires approval</label><input id="discount-limit-percent" type="number" min="0" max="100" step="0.01" class="form-control" required disabled /><small>This is a shop policy threshold, not a statutory GST limit. Approval also follows the setting below.</small></div>
<div class="company-policy-options">
@foreach(var option in new[]{("fast-billing-enabled","Enable Fast Billing Policy"),("allow-routine-discounts","Allow routine discounts"),("require-routine-reason","Require reason for routine discounts"),("require-approval-above-limit","Require approval above the limit"),("require-exceptional-reason","Require reason for exceptional discounts")}){<div class="form-check"><input id="@option.Item1" type="checkbox" class="form-check-input" disabled /><label for="@option.Item1" class="form-check-label">@option.Item2</label></div>}
</div><p id="billing-policy-effective" class="company-policy-explanation"></p><p class="company-help">For approved Fast Billing: enable the policy, allow routine discounts and turn off routine reasons. Exceptional approval and reasons remain separate controls. Saved flags are never silently removed when policy enablement changes.</p>
<div class="company-policy-actions"><button id="save-billing-policy" type="submit" class="btn btn-primary" disabled>Save Policy</button><button id="reload-billing-policy" type="button" class="btn btn-outline-secondary">Reload Policy</button></div>
</form></div></section>}
<div class="company-assistant-dock"></div>
</div>
@section Styles { <link rel="stylesheet" href="~/css/company-settings.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/company-settings.js" asp-append-version="true"></script><script src="~/js/billing-policy-settings.js" asp-append-version="true"></script> }
