@page
@model StockFlow.Web.Pages.Settings.CompanyModel
@{ ViewData["Title"] = "Shop details & bill settings"; }
<header class="sf-page-heading company-page-heading">
    <div><h1>Shop details &amp; bill settings</h1><p>Set your shop details and invoice message. New invoices retain the details saved at the time of sale.</p></div>
</header>
@if (Model.Message is not null) { <div class="alert alert-success" role="status">@Model.Message</div> }
<form method="post" enctype="multipart/form-data" id="company-settings-form" class="company-settings-form">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <section class="company-settings-card business">
        <header><span class="company-step" aria-hidden="true">1</span><div><h2>Business information</h2><p>Basic details about your shop or business.</p></div></header>
        <div class="company-settings-grid">
            <div class="company-field"><label asp-for="Input.CompanyName">Company name <span class="text-danger">*</span></label><input asp-for="Input.CompanyName" class="form-control" maxlength="150" required /><span asp-validation-for="Input.CompanyName" class="text-danger"></span></div>
            <div class="company-field"><label asp-for="Input.LegalBusinessName">Legal business name (as per GST)</label><input asp-for="Input.LegalBusinessName" type="text" class="form-control" maxlength="150"  /><span asp-validation-for="Input.LegalBusinessName" class="text-danger"></span></div><div class="company-field company-logo-field"><label>Business logo</label><div class="company-logo-controls"><div class="company-logo-preview"><img id="company-logo-preview" src="@Model.Input.LogoDataUrl" alt="Business logo" hidden="@(Model.Input.LogoDataUrl is null)" /><span id="company-logo-empty" hidden="@(Model.Input.LogoDataUrl is not null)">No logo selected</span></div><div><label for="LogoUpload" class="btn btn-outline-primary">Change logo</label><input asp-for="LogoUpload" type="file" accept="image/png,image/jpeg" class="visually-hidden" /><input asp-for="RemoveLogo" type="hidden" /><button type="button" id="company-logo-remove" class="btn btn-outline-secondary">Remove</button><small>Recommended size: 300 &times; 300 px<br />PNG or JPG (Max 2 MB)</small><span asp-validation-for="LogoUpload" class="text-danger"></span></div></div></div><div class="company-field"><label asp-for="Input.Address">Address <span class="text-danger">*</span></label><textarea asp-for="Input.Address" class="form-control" rows="2" maxlength="2000" required></textarea><span asp-validation-for="Input.Address" class="text-danger"></span></div>
            <div class="company-field"><label asp-for="Input.City">City <span class="text-danger">*</span></label><input asp-for="Input.City" type="text" class="form-control" maxlength="100" required /><span asp-validation-for="Input.City" class="text-danger"></span></div><div class="company-field"><label asp-for="Input.State">State <span class="text-danger">*</span></label><select asp-for="Input.State" class="form-select" required><option value="">Choose state</option><option>Andhra Pradesh</option><option>Arunachal Pradesh</option><option>Assam</option><option>Bihar</option><option>Chhattisgarh</option><option>Goa</option><option>Gujarat</option><option>Haryana</option><option>Himachal Pradesh</option><option>Jharkhand</option><option>Karnataka</option><option>Kerala</option><option>Madhya Pradesh</option><option>Maharashtra</option><option>Manipur</option><option>Meghalaya</option><option>Mizoram</option><option>Nagaland</option><option>Odisha</option><option>Punjab</option><option>Rajasthan</option><option>Sikkim</option><option>Tamil Nadu</option><option>Telangana</option><option>Tripura</option><option>Uttar Pradesh</option><option>Uttarakhand</option><option>West Bengal</option><option>Andaman and Nicobar Islands</option><option>Chandigarh</option><option>Dadra and Nagar Haveli and Daman and Diu</option><option>Delhi</option><option>Jammu and Kashmir</option><option>Ladakh</option><option>Lakshadweep</option><option>Puducherry</option></select><span asp-validation-for="Input.State" class="text-danger"></span></div><div class="company-field"><label asp-for="Input.PinCode">PIN code <span class="text-danger">*</span></label><input asp-for="Input.PinCode" type="text" class="form-control" maxlength="6" required /><span asp-validation-for="Input.PinCode" class="text-danger"></span></div><div class="company-field"><label asp-for="Input.MobileNumber">Phone <span class="text-danger">*</span></label><input asp-for="Input.MobileNumber" type="tel" inputmode="numeric" pattern="[0-9]{10}" class="form-control" maxlength="10" required /><span asp-validation-for="Input.MobileNumber" class="text-danger"></span><small>10-digit phone number.</small></div>
            <div class="company-field"><label asp-for="Input.AlternatePhone">Alternate phone</label><input asp-for="Input.AlternatePhone" type="tel" class="form-control" maxlength="10"  /><span asp-validation-for="Input.AlternatePhone" class="text-danger"></span></div><div class="company-field"><label asp-for="Input.Email">Email <span class="text-danger">*</span></label><input asp-for="Input.Email" class="form-control" type="email" maxlength="150" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
            <div class="company-field"><label asp-for="Input.Website">Website (optional)</label><input asp-for="Input.Website" type="url" class="form-control" maxlength="250"  /><span asp-validation-for="Input.Website" class="text-danger"></span></div><div class="company-field company-wide"><label asp-for="Input.GstNumber">GST number</label><input asp-for="Input.GstNumber" class="form-control" maxlength="15" /><span asp-validation-for="Input.GstNumber" class="text-danger"></span></div>
        <div class="company-field"><label asp-for="Input.PanNumber">PAN number (optional)</label><input asp-for="Input.PanNumber" type="text" class="form-control" maxlength="10"  /><span asp-validation-for="Input.PanNumber" class="text-danger"></span></div></div>
    </section>
    <section class="company-settings-card billing">
        <header><span class="company-step" aria-hidden="true">2</span><div><h2>Billing configuration</h2><p>Set default values for new invoices and receipts.</p></div></header>
<div class="company-settings-grid"><div class="company-field"><label asp-for="Input.InvoicePrefix">Invoice prefix <span class="text-danger">*</span></label><input asp-for="Input.InvoicePrefix" type="text" class="form-control" maxlength="30" required /><span asp-validation-for="Input.InvoicePrefix" class="text-danger"></span></div><div class="company-field"><label asp-for="Input.ReceiptPrefix">Receipt prefix <span class="text-danger">*</span></label><input asp-for="Input.ReceiptPrefix" type="text" class="form-control" maxlength="30" required /><span asp-validation-for="Input.ReceiptPrefix" class="text-danger"></span></div><div class="company-field"><label asp-for="Input.Currency">Currency <span class="text-danger">*</span></label><select asp-for="Input.Currency" class="form-select" required><option value="INR">INR (&#8377;)</option></select></div><div class="company-field"><label asp-for="Input.DefaultTaxMode">Default tax mode <span class="text-danger">*</span></label><select asp-for="Input.DefaultTaxMode" class="form-select" required><option value="EXCLUSIVE">Tax exclusive</option><option value="INCLUSIVE">Tax inclusive</option></select></div><div class="company-field company-wide"><label asp-for="Input.DefaultPaymentTermsDays">Default payment terms (optional)</label><select asp-for="Input.DefaultPaymentTermsDays" class="form-select"><option value="">No default</option><option value="0">Due on receipt</option>@foreach(var days in new[]{7,15,30,60,90}){<option value="@days">@days days</option>}</select></div><div class="company-field company-wide"><label asp-for="Input.DefaultSalespersonId">Default salesperson (optional)</label><select asp-for="Input.DefaultSalespersonId" class="form-select"><option value="">Signed-in staff member</option>@foreach(var person in Model.Salespeople){<option value="@person.UserId">@person.FullName</option>}</select><span asp-validation-for="Input.DefaultSalespersonId" class="text-danger"></span></div><small class="company-full">Use {YYYY} in prefixes for the current year. Currency is INR. Tax mode applies to new bills; payment terms suggest a due date for credit sales.</small></div>
    </section>
    <section class="company-settings-card printing">
        <header><span class="company-step" aria-hidden="true">3</span><div><h2>Invoice printing</h2><p>Message to show at the bottom of new bills.</p></div></header>
        <div class="company-settings-grid"><div class="company-field company-wide"><label asp-for="Input.InvoiceFooter">Message printed at the bottom of bills</label><textarea asp-for="Input.InvoiceFooter" class="form-control" rows="3" maxlength="250" aria-describedby="invoice-footer-count"></textarea><span asp-validation-for="Input.InvoiceFooter" class="text-danger"></span><small id="invoice-footer-count" class="company-character-count"></small></div><div class="company-field company-wide"><label asp-for="Input.TermsAndConditions">Terms &amp; conditions (optional)</label><textarea asp-for="Input.TermsAndConditions" class="form-control" rows="3" maxlength="500" aria-describedby="company-terms-count"></textarea><span asp-validation-for="Input.TermsAndConditions" class="text-danger"></span><small id="company-terms-count" class="company-character-count"></small></div></div>
    </section>
    <div class="company-settings-actions">
        <button type="button" id="company-reset-defaults" class="btn btn-outline-secondary" title="Reset billing and printing defaults. Save to apply.">Reset to default</button>
        <button permission-module="COMPANY_SETTINGS" permission-action="EDIT" class="btn btn-primary" type="submit">Save company details</button>
    </div>
</form>
@if(Access.Can("COMPANY_SETTINGS","EDIT")){
<section class="company-settings-card" id="billing-policy-settings">
    <header><div><h2>Billing Discount Policy</h2><p>Set the reduction percentage requiring approval. New Sale keeps reason and approval controls alongside the affected bill.</p></div></header>
    <div id="billing-policy-message" class="alert" role="status" data-keep-banner hidden></div>
    <form id="billing-policy-form">
        <label for="discount-limit-percent" class="form-label">Reduction above this percentage requires approval</label>
        <input id="discount-limit-percent" type="number" min="0" max="100" step="0.01" class="form-control" required disabled />
        <p class="small text-muted">Applies to the active shop. Existing restrictions stay in effect until you explicitly enable Fast Billing.</p>
        <div class="form-check"><input id="fast-billing-enabled" type="checkbox" class="form-check-input" disabled /><label for="fast-billing-enabled" class="form-check-label">Enable Fast Billing Policy</label></div>
        <div class="form-check"><input id="allow-routine-discounts" type="checkbox" class="form-check-input" checked disabled /><label for="allow-routine-discounts" class="form-check-label">Allow routine discounts</label></div>
        <div class="form-check"><input id="require-routine-reason" type="checkbox" class="form-check-input" checked disabled /><label for="require-routine-reason" class="form-check-label">Require reason for routine discounts</label></div>
        <div class="form-check"><input id="require-approval-above-limit" type="checkbox" class="form-check-input" checked disabled /><label for="require-approval-above-limit" class="form-check-label">Require approval above the limit</label></div>
        <div class="form-check"><input id="require-exceptional-reason" type="checkbox" class="form-check-input" checked disabled /><label for="require-exceptional-reason" class="form-check-label">Require reason for exceptional discounts</label></div>
        <button id="save-billing-policy" type="submit" class="btn btn-primary mt-2" disabled>Save Policy</button>
        <button id="reload-billing-policy" type="button" class="btn btn-outline-secondary mt-2">Reload Policy</button>
    </form>
</section>
}
@section Styles { <link rel="stylesheet" href="~/css/company-settings.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/company-settings.js" asp-append-version="true"></script><script src="~/js/billing-policy-settings.js" asp-append-version="true"></script> }
