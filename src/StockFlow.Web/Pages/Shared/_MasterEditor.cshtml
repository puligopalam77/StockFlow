@model string
@{
    var singular = Model switch { "Categories" => "Category", "Brands" => "Brand", "Suppliers" => "Supplier", _ => "Product" };
}
@if(Model == "Categories") {
    <partial name="_CategoryRegistration" />
} else if(Model == "Brands") {
    <partial name="_BrandRegistration" />
} else {
<dialog data-sf-dialog="workflow" id="editor" class="configuration-dialog @(Model == "Products" ? "configuration-dialog-wide" : "") @(Model == "Suppliers" ? "supplier-registration-dialog" : "")" aria-labelledby="editor-title" aria-describedby="editor-help">
    <button id="close-editor" class="configuration-close" type="button" aria-label="Close registration">&times;</button>
    <h2 id="editor-title">Add @singular</h2>
    <p id="editor-help">Enter the @singular.ToLowerInvariant() details for your business.</p>
    <div id="editor-message" class="alert d-none" role="alert"></div>
    <form id="master-form">
        <div id="form-fields" class="row g-3"></div>
        <div class="configuration-dialog-actions">
            <button type="button" id="cancel-edit" class="btn btn-outline-secondary">Cancel</button>
            <button type="submit" class="btn btn-primary">Save @singular</button>
        </div>
    </form>
</dialog>
}
