<div id="quotations" data-mode="editor">
<header class="sf-page-heading"><div><h1 id="quotation-title">New Quotation</h1><p>Each revision keeps a copy in quotation history. Stock is deducted only when the sale is completed.</p></div><a class="btn btn-dark" href="/Quotations">Back to Quotations</a></header>
<div id="quotation-message" role="alert" class="alert alert-danger" hidden></div>
<form id="quotation-form">
<div class="card card-body quote-header-grid">
<label>Customer search<input id="quotation-customer-search" class="form-control" placeholder="Name or mobile" maxlength="100" /><select id="quotation-customer" class="form-select" required aria-label="Select customer"><option value="">Select customer</option></select></label>
<label>Quotation date<input id="quotation-date" type="date" required class="form-control" /></label><label>Valid until<input id="quotation-until" type="date" required class="form-control" /></label><label>Reference<input id="quotation-reference" class="form-control" maxlength="150" /></label>
</div>
<section class="card card-body mt-3"><h2>Items in this quotation</h2><label>Search product or SKU<input id="quotation-product-search" class="form-control" maxlength="100" placeholder="Search current catalog" /></label><div id="quotation-products" class="quote-results"></div>
<details id="quotation-manual"><summary>Add a manual item</summary><div class="quote-header-grid"><label>Description<input id="quotation-manual-name" class="form-control" maxlength="200" /></label><label>Unit price<input id="quotation-manual-price" type="number" min="0" step="0.01" class="form-control" /></label><label>MRP (optional)<input id="quotation-manual-mrp" type="number" min="0" step="0.01" class="form-control" /></label><label>Tax classification<select id="quotation-manual-tax" class="form-select"><option value="0">Ordinary item — GST not classified</option></select></label></div><button type="button" id="quotation-add-manual" class="btn btn-dark">Add Manual Item</button></details>
<div class="table-responsive"><table class="table quote-lines"><thead><tr><th>Product / SKU</th><th>Qty</th><th>Price</th><th>Discount %</th><th>Reason</th><th>Tax %</th><th>Line Total</th><th>Action</th></tr></thead><tbody id="quotation-lines"></tbody></table></div></section>
<div class="quote-lower-grid mt-3"><div class="card card-body"><label>Notes<textarea id="quotation-notes" class="form-control" maxlength="2000" rows="2"></textarea></label><label>Terms and conditions<textarea id="quotation-terms" class="form-control" maxlength="4000" rows="3"></textarea></label></div>
<div class="card card-body"><label>Quotation discount (₹)<input id="quotation-discount" type="number" min="0" step="0.01" value="0" class="form-control" /></label><label>Discount reason (when required)<input id="quotation-reason" class="form-control" maxlength="500" /></label><label>Place of supply (for GST checkout)<select id="quotation-pos" class="form-select"><option value="">Choose actual supply state</option>@foreach(var s in StockFlow.Application.Common.GstRules.States.Where(s=>s.Key!="28")){<option value="@s.Key">@s.Key — @s.Value</option>}</select></label><label>Delivery address<textarea id="quotation-delivery" class="form-control" maxlength="1000" rows="2"></textarea></label><div id="quotation-summary" aria-live="polite"></div><button id="quotation-save" class="btn btn-primary mt-2" disabled>Save Quotation Revision</button><p id="quotation-policy" class="small"></p></div></div>
</form></div>
