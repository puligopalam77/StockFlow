@inject StockFlow.Application.Common.BusinessScope QuotationScope
<div id="quotations" data-mode="editor" data-scope="@(QuotationScope.TenantId):@(QuotationScope.UserId):@(QuotationScope.StoreId):@(QuotationScope.LocationId):@QuotationScope.BusinessProfileCode" data-can-price="@Access.Can("SALES","PRICE_OVERRIDE").ToString().ToLowerInvariant()" data-can-discount="@Access.Can("SALES","DISCOUNT").ToString().ToLowerInvariant()">
<header class="sf-page-heading quote-heading"><div class="quote-title-row"><h1 id="quotation-title">New Quotation</h1><button type="button" id="quotation-help-button" class="quote-help-button" popovertarget="quotation-help" aria-label="About quotations">ⓘ</button><div id="quotation-help" popover class="quote-help"><strong>About quotations</strong><p>Saved quotations keep revision history and do not deduct or reserve inventory. Availability, pricing, applicable GST and permissions are checked again during sale conversion.</p></div></div><div class="quote-header-actions"><span id="quotation-saved-actions"></span><a class="btn btn-outline-secondary" href="/Quotations">Back to Quotations</a></div></header>
<div id="quotation-message" role="alert" class="alert alert-danger" hidden></div>
<form id="quotation-form" novalidate>
<div class="quote-workspace"><div class="quote-editor-column">
<section class="card quote-card"><div class="quote-card-body">
<label for="quotation-customer-search">Customer <span aria-hidden="true">*</span></label>
<div class="quote-customer-row" id="quotation-customer-picker"><div class="quote-customer-field">
<input id="quotation-customer-search" class="form-control" placeholder="Search customer by name or mobile..." maxlength="150" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="quotation-customers" aria-describedby="quotation-customer-status" />
<div id="quotation-customer-current" class="quote-selected-customer" hidden><div><strong id="quotation-customer-name"></strong><span id="quotation-customer-mobile"></span></div><button id="quotation-customer-clear" type="button" class="btn btn-sm" aria-label="Clear selected customer">×</button></div>
<div id="quotation-customers" class="quote-customer-results" role="listbox" aria-label="Customer matches" hidden></div>
<select id="quotation-customer" hidden aria-hidden="true" tabindex="-1"><option value="">Select customer</option></select>
</div><div id="quotation-customer-actions"></div></div><p id="quotation-customer-status" class="quote-field-status" role="status"></p>
<p id="quotation-customer-error" class="quote-validation" role="status"></p><div class="quote-metadata"><label>Quotation Date<input id="quotation-date" type="date" required class="form-control" aria-describedby="quotation-date-error" /></label><label>Valid Until<input id="quotation-until" type="date" required class="form-control" aria-describedby="quotation-date-error" /></label><label>Customer Reference (Optional)<input id="quotation-reference" class="form-control" maxlength="150" /></label></div><p id="quotation-date-error" class="quote-validation" role="status"></p>
</div></section>
<section class="card quote-card"><div class="quote-card-title"><h2>Items in this quotation <small id="quotation-item-count">0 items</small></h2></div><div class="quote-card-body">
<div class="quote-search-row"><div class="quote-search-field"><label for="quotation-product-search" class="visually-hidden">Search products</label><input id="quotation-product-search" class="form-control" maxlength="150" placeholder="Search product name, SKU or barcode" aria-describedby="quotation-product-status" /></div><button id="quotation-manual" type="button" class="btn btn-outline-secondary" hidden>+ Quick Add Item</button></div>
<p id="quotation-product-status" class="quote-field-status" role="status"></p><div id="quotation-products" class="quote-results"></div>
<div id="quotation-empty" class="quote-empty"><svg class="sf-icon" aria-hidden="true"><use href="/images/icons.svg#box" /></svg><strong>Your quotation is empty</strong><span>Search for a product or add a manual item.</span></div><p id="quotation-items-error" class="quote-validation" role="status"></p>
<div id="quotation-table-region" class="table-responsive quote-table-scroll" tabindex="0" role="region" aria-label="Quotation items, scroll horizontally for more columns" hidden><table class="table quote-lines"><thead><tr><th>Product / Variant</th><th>SKU</th><th>Qty</th><th data-quote-mrp hidden>MRP (₹)</th><th>Selling Price (₹)</th><th>Discount (%)</th><th>Tax (%)</th><th>Line Total (₹)</th><th>Actions</th></tr></thead><tbody id="quotation-lines"></tbody></table></div>
<p id="quotation-pricing-mode" class="quote-field-status"></p>
</div></section>
</div><aside class="quote-commercial-column" aria-label="Quotation summary and commercial details">
<section class="card quote-card quote-summary-card"><div class="quote-card-title"><h2>Quotation Summary</h2></div><div class="quote-card-body"><div id="quotation-summary" class="quote-summary" aria-live="polite"><div id="quotation-discount-row" class="quote-discount-row"><label for="quotation-discount">Quotation Discount (₹)</label><input id="quotation-discount" type="number" min="0" step="0.01" value="0" required class="form-control" aria-describedby="quotation-discount-error" /></div><p id="quotation-discount-error" class="quote-validation" role="status"></p><label id="quotation-reason-field" hidden>Discount Reason<input id="quotation-reason" class="form-control" maxlength="500" /></label><p id="quotation-policy" class="quote-field-status"></p></div><p id="quotation-calculation-status" class="quote-field-status" role="status">Add items for a server estimate.</p><div class="quote-save-bar"><p id="quotation-validation" class="quote-validation" role="status"></p><button id="quotation-save" class="btn btn-primary" disabled>Save Quotation</button></div></div></section>
<section class="card quote-card"><div class="quote-card-title"><h2>Commercial Details</h2></div><div class="quote-card-body quote-commercial-fields">
<label>Place of Supply<select id="quotation-pos" class="form-select" aria-describedby="quotation-pos-error"><option value="">Choose actual supply state</option>@foreach(var s in StockFlow.Application.Common.GstRules.States.Where(s=>s.Key!="28")){<option value="@s.Key">@s.Key — @s.Value</option>}</select></label><p id="quotation-pos-error" class="quote-validation" role="status"></p>
<div><span class="quote-field-label">Delivery Address</span><p id="quotation-delivery-preview" class="quote-address-preview">No delivery address supplied.</p><details id="quotation-delivery-options"><summary>Edit Delivery Address</summary><label for="quotation-delivery" class="visually-hidden">Quotation delivery address</label><textarea id="quotation-delivery" class="form-control" maxlength="1000" rows="2"></textarea></details></div>
<label>Notes (Optional)<textarea id="quotation-notes" class="form-control" maxlength="2000" rows="2"></textarea></label><details id="quotation-terms-options"><summary>Terms &amp; Conditions (Optional)</summary><label for="quotation-terms" class="visually-hidden">Terms and conditions</label><textarea id="quotation-terms" class="form-control" maxlength="4000" rows="3"></textarea></details>
</div></section></aside></div>
</form>
<dialog data-sf-dialog="medium" id="quotation-manual-dialog" class="quote-dialog" aria-labelledby="quotation-manual-title"><form id="quotation-manual-form"><header><h2 id="quotation-manual-title">Quick Add Item</h2><button type="button" class="btn btn-sm btn-dark" id="quotation-manual-close" aria-label="Close Quick Add Item">×</button></header><label>Description<input id="quotation-manual-name" class="form-control" maxlength="200" required /></label><label>Unit Price (₹)<input id="quotation-manual-price" type="number" min="0" step="0.01" required class="form-control" /></label><label>MRP (Optional)<input id="quotation-manual-mrp" type="number" min="0" step="0.01" class="form-control" /></label><label>Tax Classification<select id="quotation-manual-tax" class="form-select"><option value="0">Ordinary item — GST not classified</option></select></label><p class="quote-field-status">Preparing a manual quotation line does not create inventory.</p><button type="submit" id="quotation-add-manual" class="btn btn-primary">Add Item</button></form></dialog>
@if(Access.Can("CUSTOMERS","CREATE")){
<div id="quotation-new-customer" hidden><label for="new-customer-name">Name</label><input id="new-customer-name" minlength="2" maxlength="150" class="form-control" /><label for="new-customer-mobile">Mobile</label><input id="new-customer-mobile" type="tel" maxlength="10" pattern="[0-9]{10}" inputmode="numeric" class="form-control" /><label for="new-customer-gst">GSTIN</label><input id="new-customer-gst" maxlength="15" class="form-control" /><label for="new-customer-address">Address</label><textarea id="new-customer-address" maxlength="1000" rows="2" class="form-control"></textarea><button id="create-customer" type="button">Save and select customer</button></div>
}
</div>
