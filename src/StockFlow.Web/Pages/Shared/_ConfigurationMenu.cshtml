@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var groups = new[] {
        ("Product Catalog", new[] { ("CATEGORIES", "Categories"), ("BRANDS", "Brands"), ("PRODUCTS", "Products") }),
        ("Business Partners", new[] { ("SUPPLIERS", "Suppliers"), ("CUSTOMERS", "Customers") })
    };
}
@foreach (var (name, items) in groups)
{
    var visible = items.Where(item => Access.Can(item.Item1)).ToArray();
    if (visible.Length == 0) { continue; }
    var active = visible.Any(item => page.StartsWith($"/{item.Item2}/", StringComparison.OrdinalIgnoreCase));
    <details class="sf-nav-group sf-catalog-nav" open="@active">
        <summary class="sf-nav-child @(active ? "sf-nav-group-active" : "")">@name <span class="sf-nav-chevron" aria-hidden="true">›</span></summary>
        <div class="sf-nav-children" aria-label="@name">
    @foreach (var (module, label) in visible)
    {
        if (Access.Can(module))
        {
            var selected = page.StartsWith($"/{label}/", StringComparison.OrdinalIgnoreCase);
    <a href="/@label" class="sf-nav-child @(selected ? "active" : "")" aria-current="@(selected ? "page" : null)">@label</a>
        }
    }
        </div>
    </details>
}
