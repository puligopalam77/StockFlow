@using StockFlow.Application.DTOs.Security
@inject StockFlow.Application.Common.BusinessScope ShopScope
@inject Microsoft.Extensions.Configuration.IConfiguration FeatureConfiguration
@{
    var path = StockFlow.Web.Navigation.RetailNavigation.CanonicalPath(Context.Request.Path.Value ?? "");
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var navigation = Access.User?.NavigationModules.Where(m => m.IsActive).OrderBy(m => m.SortOrder).ThenBy(m => m.ModuleId).ToArray() ?? [];

    bool Allowed(NavigationModule item)
    {
        if(item.ModuleCode=="REPLENISHMENT"&&!FeatureConfiguration.GetValue<bool>("Features:Replenishment"))return false;
        if (item.RequiredPermissions.Length == 0) return false;
        return item.RequiredPermissions.Any(requirement =>
        {
            var parts = requirement.Split(':', 2);
            return parts.Length == 2 && Access.Can(parts[0], parts[1]);
        });
    }
    var reportsVisible=navigation.Any(m=>m.Route=="/Reports"&&Allowed(m));
    bool Matches(string? url)
    {
        if (reportsVisible && StockFlow.Web.Navigation.RetailNavigation.IsReportPath(path,Context.Request.Query["fromReports"] == "1")) return false;
        if (string.IsNullOrWhiteSpace(url)) return false;
        if (url == "/") return path == "";
        return path.Equals(url, StringComparison.OrdinalIgnoreCase) || path.StartsWith(url + "/", StringComparison.OrdinalIgnoreCase);
    }
    bool MovedLink(string? route) => route is "/Configuration" or "/Products" or "/Categories" or "/Brands" or "/Suppliers" or "/Customers" or "/Labels";
    var roots = navigation.Where(m => m.ParentModuleId is null && !MovedLink(m.Route)).ToList();
    // Older navigation metadata may predate CRM. The container still exposes only
    // the existing Customers page to users who already have customer permission.
    if (!roots.Any(m => m.ModuleCode == "CRM") && Access.Can("CUSTOMERS"))
        roots.Add(new NavigationModule { ModuleId = -1, ModuleCode = "CRM", ModuleName = "Customer Relationships", Icon = "users", SortOrder = 59, IsActive = true });
    roots = roots.OrderBy(m => m.ModuleCode == "CRM" ? (roots.FirstOrDefault(r => r.ModuleCode == "SETUP")?.SortOrder ?? 60) - 1 : m.SortOrder).ThenBy(m => m.ModuleId).ToList();
    string Caption(string name) => name switch
    {
        "Dashboard" => "Home",
        "Sell / Billing" or "Sales & Billing" => "Sales",
        "Receive Stock" => "Purchases",
        "Setup" or "Administration" => "Settings",
        "Customer Relationships" => "Customers",
        "Operating Expenses" => "Expenses",
        "Users" => "Staff & Access",
        "Roles & permissions" => "Roles & Permissions",
        "Stores" => "Stores & Locations",
        "Security settings" => "Security",
        "Inventory" => "Inventory",
        "Current stock" or "Inventory Overview" => "Stock Overview",
        "Low stock" or "Low Stock Alerts" => "Low Stock",
        "Stock transfers" => "Stock Transfers",
        "Scan product / serial" => "Scan & Lookup",
        "Search records" or "Inventory History" => "Stock History",
        "Quotations & Estimates" => "Quotations",
        "Service & Warranty" => "Service & Warranty",
        "Warranty lookup" => "Warranty Lookup",
        "Warranty claims" => "Warranty Claims",
        "Expiring warranties" => "Warranty Expiry",
        "Configuration" => "Product Catalog",
        "New stock receipt" => "Receive Stock",
        "Counter billing" => "New Sale",
        "Company settings" => "Business & Billing",
        "Stock Outflow" or "Stock outflow" or "Outflow history" => "Stock Out",
        "Service history" => "Repair History",
        "New service request" => "New Repair",
        "Pending services" => "Open Repairs",
        "Audit logs" => "Change history",
        _ => name
    };
}
<nav class="sf-nav sf-shop-nav" aria-label="Shop tasks">
@foreach (var root in roots)
{
    if (root.Route == "/Reports")
    {
        if (Allowed(root)) { <partial name="_ReportsNavigation" /> }
        continue;
    }
    var children = navigation.Where(m => m.ParentModuleId == root.ModuleId && Allowed(m) && !MovedLink(m.Route)).ToArray();
    var showCatalog = root.ModuleCode == "INVENTORY_CONTROL" && new[] { "PRODUCTS", "CATEGORIES", "BRANDS", "BARCODES" }.Any(module => Access.Can(module));
    if (root.ModuleCode == "RECEIVE_STOCK" && Access.Can("SUPPLIERS"))
        children = children.Append(new NavigationModule { ModuleCode = "SUPPLIERS", ModuleName = "Suppliers", Route = "/Suppliers", IsActive = true }).ToArray();
    if (root.ModuleCode == "CRM" && Access.Can("CUSTOMERS"))
        children = children.Append(new NavigationModule { ModuleCode = "CUSTOMERS", ModuleName = "Customers", Route = "/Customers", IsActive = true }).ToArray();
    var showIntegrations = root.ModuleCode == "SETUP" && Access.Can("EWAY_BILLS", "CONFIGURE_PROVIDER");
    var showStaffAccess = root.ModuleCode == "SETUP" && (Access.Can("USER_MANAGEMENT") || Access.Can("ROLE_MANAGEMENT"));
    if(showStaffAccess) children = children.Where(m => m.Route is not ("/Admin/Users" or "/Admin/Roles")).ToArray();
    if (showIntegrations) children = children.Where(m => m.Route != "/EWayBills/Provider").ToArray();
    var showBusinessSetup = root.ModuleCode == "SETUP" && (Access.Can("COMPANY_SETTINGS") || Access.Can("GST_SETTINGS") || Access.Can("STORES"));
    if(showBusinessSetup) children = children.Where(m => m.Route is not ("/Settings/Company" or "/Admin/Gst" or "/Admin/Stores")).ToArray();
    var showNotificationCenter = Access.Can("COMPANY_SETTINGS") && navigation.Any(m => m.ParentModuleId == root.ModuleId && m.Route == "/Settings/Company");
    if (children.Any(m => m.Route == "/Purchases" || m.Route == "/StockInflow"))
    {
        children = children.Where(m => m.Route != "/Purchases/Create")
            .OrderBy(m => m.Route == "/StockInflow" ? 0 : m.Route == "/Purchases" ? 1 : m.Route == "/Labels" ? 2 : 3).ToArray();
    }
    if (root.ModuleName == "Sell / Billing")
    {
        children = children.OrderBy(m => m.Route == "/Sales/Create" ? 0 : m.Route == "/Sales" ? 1 : 2).ToArray();
    }
    if (root.ModuleName == "Service & Warranty")
    {
        children = children.OrderBy(m => m.Route switch
        {
            "/Service/Create" => 0,
            "/Service/Pending" => 1,
            "/Service" => 2,
            "/Warranty/Lookup" => 3,
            "/Warranty/Claims" => 4,
            "/Warranty/Expiring" => 5,
            _ => 6
        }).ToArray();
    }
    if (root.Route is not null)
    {
        if (!Allowed(root)) { continue; }
        var active = Matches(root.Route);
    <a class="sf-nav-link @(active ? "active" : "")" href="@root.Route" aria-current="@(active ? "page" : null)">
        <svg class="sf-icon" aria-hidden="true">
            <use href="@($"/images/icons.svg#{root.Icon ?? "document"}")" />
        </svg>
        <span>@Caption(root.ModuleName)</span>
    </a>
    }
    else
    {
        if (children.Length == 0 && !showCatalog && !showIntegrations && !showBusinessSetup && !showStaffAccess) { continue; }
        var activeUrl = children.Where(m => Matches(m.Route)).OrderByDescending(m => m.Route?.Length ?? 0).Select(m => m.Route).FirstOrDefault();
        if(showBusinessSetup && (Matches("/Settings/Company") || Matches("/Settings/BusinessProfile") || Matches("/Admin/Gst") || Matches("/Admin/Stores"))) activeUrl=path;
        if(showStaffAccess && (Matches("/Admin/Users") || Matches("/Admin/Roles"))) activeUrl=path;
        if (showIntegrations && path.Equals("/EWayBills/Provider", StringComparison.OrdinalIgnoreCase)) activeUrl = "/EWayBills/Provider";
        if (showCatalog)
            activeUrl ??= new[] { ("PRODUCTS", "/Products"), ("CATEGORIES", "/Categories"), ("BRANDS", "/Brands"), ("BARCODES", "/Labels") }
                .Where(item => Access.Can(item.Item1) && Matches(item.Item2)).Select(item => item.Item2).FirstOrDefault();
        if (path.Equals("/Purchases/Create", StringComparison.OrdinalIgnoreCase) && children.Any(m => m.Route == "/StockInflow")) activeUrl = "/StockInflow";
        if (showNotificationCenter && page == "/Configuration/Notifications") activeUrl = "/Configuration/Notifications";
        if (showNotificationCenter && ShopScope.IsOwner && Access.Can("COMPANY_SETTINGS", "EDIT") && page == "/Configuration/WhatsApp") activeUrl = "/Configuration/Notifications/WhatsApp";
        if (showNotificationCenter && ShopScope.CanReviewStores && page == "/Settings/BusinessProfile") activeUrl = "/Settings/BusinessProfile";
    <details class="sf-nav-group" open="@(activeUrl is not null)" data-nav-group="@root.ModuleName">
        <summary class="sf-nav-link @(activeUrl is not null ? "sf-nav-group-active" : "")">
            <svg class="sf-icon" aria-hidden="true">
                <use href="@($"/images/icons.svg#{root.Icon ?? "document"}")" />
            </svg>
            <span>@Caption(root.ModuleName)</span>
            <span class="sf-nav-chevron" aria-hidden="true">›</span>
        </summary>
        <div class="sf-nav-children">
            @foreach (var child in children)
            {
            <a class="sf-nav-child @(child.Route == activeUrl ? "active" : "")" href="@child.Route" aria-current="@(child.Route == activeUrl ? "page" : null)">@(child.Route switch { "/Purchases/Create" => "Receive Stock", "/Purchases" => "Purchase Orders", "/StockInflow" => "Receive Stock", "/Sales" => "Sales History", "/Sales/Create" => "New Sale", "/Settings/Company" => "Business & Billing", _ => Caption(child.ModuleName) })</a>
            }
            @if(showBusinessSetup) { <partial name="_BusinessSetupNavigation" /> }
            @if(showStaffAccess) { <partial name="_StaffAccessNavigation" /> }
            @if(showCatalog) { <partial name="_ConfigurationMenu" /> }
            @if(showIntegrations) { <partial name="_IntegrationsNavigation" /> }
            @if(showNotificationCenter) {
            @if(ShopScope.CanReviewStores && !showBusinessSetup) {
            <a class="sf-nav-child @(activeUrl == "/Settings/BusinessProfile" ? "active" : "")" href="/Settings/BusinessProfile" aria-current="@(activeUrl == "/Settings/BusinessProfile" ? "page" : null)">Shop Business Profile</a>
            }
            <a class="sf-nav-child @(activeUrl == "/Configuration/Notifications" ? "active" : "")" href="/Configuration/Notifications" aria-current="@(activeUrl == "/Configuration/Notifications" ? "page" : null)">Notifications</a>
            @if(ShopScope.IsOwner && Access.Can("COMPANY_SETTINGS", "EDIT")) {
            <a class="sf-nav-child @(activeUrl == "/Configuration/Notifications/WhatsApp" ? "active" : "")" href="/Configuration/Notifications/WhatsApp" aria-current="@(activeUrl == "/Configuration/Notifications/WhatsApp" ? "page" : null)">WhatsApp Settings</a>
            }
            }
        </div>
    </details>
    }
}
</nav>
