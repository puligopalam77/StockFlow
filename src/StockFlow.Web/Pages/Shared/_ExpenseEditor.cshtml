@inject StockFlow.Application.Common.BusinessScope Scope
@{
    var createExpense = Context.Request.Path == "/Expenses/Create";
    var paymentMethods = new[] { (Code: "CASH", Label: "Cash"), (Code: "UPI", Label: "UPI"), (Code: "DEBIT_CARD", Label: "Debit Card"), (Code: "CREDIT_CARD", Label: "Credit Card"), (Code: "BANK_TRANSFER", Label: "Bank Transfer") };
}
<div id="expenses" class="@(createExpense ? "expense-create" : null)" data-mode="editor" data-id="@Context.Request.Query["id"]" data-scope="@Scope.TenantId.@Scope.UserId.@Scope.StoreId.@Scope.LocationId.@Scope.BusinessProfileCode">
<header class="expense-heading"><div><h1>@(Context.Request.Path=="/Expenses/Create"?"New Operating Expense":"Expense Details")</h1><p>Record and manage everyday business expenses.</p></div><strong id="expense-state" class="@(createExpense ? null : "expense-badge")" role="status" hidden="@createExpense">Loading...</strong></header>
<div id="expense-message" role="alert" data-keep-banner hidden></div><button type="button" id="expense-retry" class="btn btn-dark" hidden>Retry unchanged request</button>
@if(!createExpense){<p class="expense-notice">Operating expenses do not affect stock.</p>}
<div class="expense-workspace"><div class="expense-main">
<form id="expense-form" class="card card-body" data-unsaved-context="Operating expense details"><h2>Expense Details</h2><fieldset id="expense-fields" disabled><div class="expense-fields-grid">
<div><div class="expense-label-action"><label for="expense-category">Category *</label><button type="button" data-master="CATEGORY" class="expense-add">+ Add Category</button></div><select id="expense-category" class="form-select" required></select></div>
<div><div class="expense-label-action"><label for="expense-payee">Payee *</label><button type="button" data-master="PAYEE" class="expense-add">+ Add Payee</button></div><select id="expense-payee" class="form-select" required></select></div>
<div><label for="expense-incurred">Expense Date *</label><input id="expense-incurred" class="form-control" type="date" min="2000-01-01" required /></div>
<div><label for="expense-amount">Amount (&#8377;) *</label><input id="expense-amount" class="form-control" type="number" min="0.01" max="9999999999.99" step="0.01" required /></div>
<div class="expense-full expense-description"><label for="expense-description">Description *</label><textarea id="expense-description" class="form-control" rows="2" maxlength="2000" placeholder="e.g., Shop electricity bill for November 2026" required></textarea></div>
<div class="expense-full">@if(createExpense){
<fieldset id="expense-gst-applicable" class="expense-gst-choice"><legend>GST Applicable?</legend><div class="expense-gst-toggle">
<input id="expense-gst-no" class="btn-check" type="radio" name="expense-gst" value="NO_GST" checked /><label for="expense-gst-no">No GST</label>
<input id="expense-gst-includes" class="btn-check" type="radio" name="expense-gst" value="INCLUDES_GST" /><label for="expense-gst-includes">Includes GST</label>
</div></fieldset>
}else{<label for="expense-gst-applicable">GST Applicable?</label><select id="expense-gst-applicable" class="form-select"><option value="NO_GST">No GST</option><option value="INCLUDES_GST">Includes GST</option></select>}</div>
</div></fieldset><div id="expense-correction" hidden><label for="expense-reason">Correction / Cancellation Reason *</label><textarea id="expense-reason" class="form-control" rows="2" maxlength="1000" placeholder="Explain this change for the audit history"></textarea></div></form>
<section id="expense-gst-section" class="card card-body" hidden><h2>GST Details</h2><fieldset id="expense-gst-fields" disabled><div class="expense-fields-grid">
<div><label for="expense-gst-rule">GST Rate *</label><select id="expense-gst-rule" class="form-select" form="expense-form" data-sf-select="native" aria-describedby="expense-gst-message"></select></div>
<div><label for="expense-gst-gstin">Supplier GSTIN (optional)</label><input id="expense-gst-gstin" class="form-control" form="expense-form" maxlength="15" autocomplete="off" /></div>
<div><label for="expense-gst-invoice">Invoice Number (optional)</label><input id="expense-gst-invoice" class="form-control" form="expense-form" maxlength="150" /></div>
<div><label for="expense-gst-itc">ITC Status</label><select id="expense-gst-itc" class="form-select" form="expense-form" data-sf-select="native" aria-readonly="@(createExpense ? "true" : "false")"><option value="NOT_ASSESSED">Not Assessed</option><option value="NOT_ELIGIBLE">Not Eligible</option><option value="ELIGIBLE_VERIFIED" disabled>Eligible — Verified</option></select></div>
</div></fieldset><div class="expense-tax-feedback"><p id="expense-gst-message" class="expense-muted" role="status"></p>@if(Access.Can("GST_SETTINGS")){<a id="expense-gst-settings" href="/Admin/Gst" hidden>GST Settings</a>}</div><dl id="expense-gst-amounts" class="expense-tax-values" hidden><div><dt>Taxable Amount</dt><dd id="expense-gst-taxable"></dd></div><div><dt>GST included</dt><dd id="expense-gst-tax"></dd></div></dl></section>
<section id="expense-initial-payment" class="card card-body" hidden><h2>Payment Details</h2><div class="@(createExpense ? "expense-payment-grid" : null)"><div><label for="expense-initial-state">Payment Status</label><select id="expense-initial-state" class="form-select"><option value="UNPAID">Unpaid</option><option value="PARTIAL">Partially Paid</option><option value="PAID">Paid</option></select></div><div id="expense-initial-fields" hidden><div class="expense-fields-grid">
@if(createExpense){<div id="expense-initial-amount-wrap"><label for="expense-initial-amount">Amount Paid (&#8377;) *</label><input id="expense-initial-amount" class="form-control" type="number" min="0.01" max="9999999999.99" step="0.01" /><small class="expense-live-balance">Balance Due: <output id="expense-initial-balance" for="expense-amount expense-initial-amount">&#8377;0.00</output></small></div>}
<div><label for="expense-initial-method">Payment Method *</label><select id="expense-initial-method" class="form-select" required>@foreach(var method in paymentMethods){<option value="@method.Code">@method.Label</option>}</select></div>
<div><label for="expense-initial-date">Payment Date *</label><input id="expense-initial-date" class="form-control" type="date" /></div>
@if(!createExpense){<div id="expense-initial-amount-wrap"><label for="expense-initial-amount">Amount Paid (&#8377;) *</label><input id="expense-initial-amount" class="form-control" type="number" min="0.01" max="9999999999.99" step="0.01" /></div>}
<div><label for="expense-initial-reference">Transaction Reference (optional)</label><input id="expense-initial-reference" class="form-control" maxlength="150" /></div>
@if(!createExpense){<div class="expense-full"><label for="expense-initial-notes">Payment Notes (optional)</label><input id="expense-initial-notes" class="form-control" maxlength="1000" /></div>}</div>
@if(createExpense){<details id="expense-initial-more" class="expense-payment-notes"><summary>More Details</summary><label for="expense-initial-notes">Payment Notes (optional)</label><input id="expense-initial-notes" class="form-control" maxlength="1000" /></details>}
<label class="expense-confirm"><input id="expense-initial-confirm" type="checkbox" /> @(createExpense ? "Payment has been made" : "I confirm this payment was made using the selected method.")</label>@if(!createExpense){<small>Manual payment evidence; provider settlement is not verified.</small>}</div></div>@if(createExpense){<p class="expense-muted expense-draft-note">Save Draft does not record a payment.</p>}</section>
<section id="expense-settlement" class="card card-body" hidden><h2>Payment Details</h2><p id="expense-balance"></p><button id="expense-payment-open" type="button" class="btn btn-primary" hidden>Record Payment</button></section>
<details id="expense-refund-tools" class="card card-body" hidden><summary>Refund / Reversal</summary><form id="expense-payment" hidden data-unsaved-context="Expense refund or reversal"><div class="expense-fields-grid">
<div><label for="expense-payment-action">Action</label><select id="expense-payment-action" class="form-select"><option value="REFUND">Refund received</option></select></div>
<div><label for="expense-paid-date">Payment / Returned Date *</label><input id="expense-paid-date" class="form-control" type="date" required /></div>
<div><label for="expense-payment-amount">Amount (&#8377;) *</label><input id="expense-payment-amount" class="form-control" type="number" min="0.01" max="9999999999.99" step="0.01" required /></div>
<div><label for="expense-method">Method</label><select id="expense-method" class="form-select">@foreach(var method in paymentMethods){<option value="@method.Code">@method.Label</option>}</select></div>
<div><label for="expense-reference">Reference (optional)</label><input id="expense-reference" class="form-control" maxlength="150" /></div><div><label for="expense-payment-reason">Refund / Reversal Reason</label><input id="expense-payment-reason" class="form-control" maxlength="1000" /></div></div><button class="btn btn-dark" type="submit">Record Refund</button><p class="expense-muted">Recorded evidence only. Reversals use this form's date and reason.</p></form></details>
<section id="expense-receipt-section" class="card card-body"><div class="expense-receipt-header"><div><h2>Receipt (Optional)</h2><p id="expense-attachment-note" class="expense-muted">PDF, JPG or PNG · Max 5 MB</p></div>@if(createExpense){<button id="expense-receipt-choose" class="btn btn-dark" type="button" form="expense-attachment-form"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 15v6h16v-6" /></svg><span id="expense-receipt-choose-label">Upload Receipt</span></button>}</div>
<form id="expense-attachment-form" hidden enctype="multipart/form-data" data-unsaved-context="Expense receipt" novalidate>
    <input id="expense-file" type="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/png,image/jpeg" aria-label="Choose expense receipt" aria-describedby="expense-attachment-note expense-receipt-error" hidden />
    <div class="expense-receipt-actions">@if(!createExpense){<button id="expense-receipt-choose" class="btn btn-dark" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 15v6h16v-6" /></svg><span id="expense-receipt-choose-label">Upload Receipt</span></button>}<button id="expense-attachment-upload" class="btn btn-primary" type="submit" hidden>Retry Upload</button></div>
    <div id="expense-receipt-selection" class="expense-receipt-selection" hidden>
        <span id="expense-receipt-visual" class="expense-receipt-visual" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 3h10l4 4v14H5ZM14 3v5h5M8 12h8M8 16h8" /></svg></span>
        <div class="expense-receipt-info" aria-live="polite"><span id="expense-receipt-name"></span><small id="expense-receipt-meta"></small></div>
        <div class="expense-receipt-file-actions">
            <a id="expense-receipt-view" class="expense-receipt-action" target="_blank" rel="noopener" aria-label="View selected receipt" title="View receipt" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg></a>
            <button id="expense-receipt-replace" class="expense-receipt-action" type="button" aria-label="Replace selected receipt" title="Replace receipt" aria-describedby="expense-attachment-note expense-receipt-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 11a9 9 0 1 1 2 7M3 4v7h7" /></svg></button>
            <button id="expense-receipt-remove" class="expense-receipt-action" type="button" aria-label="Remove selected receipt" title="Remove receipt" data-local-cancel><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7M14 10v7" /></svg></button>
        </div>
    </div>
    <p id="expense-receipt-error" class="expense-muted" role="alert" hidden></p>
    <a id="expense-receipt-saved" href="#" hidden>View saved expense</a>
</form><ul id="expense-attachments"></ul></section>
</div><aside class="expense-sidebar" aria-label="Expense summary and actions"><section class="card card-body"><h2 id="expense-summary-title">@(createExpense ? "Expense Preview" : "Expense Summary")</h2><p id="expense-summary-state" class="expense-muted" role="status">@(createExpense ? "Not saved yet." : "Unsaved preview")</p><dl class="expense-summary-values"><div><dt>Expense Amount</dt><dd id="expense-summary-amount">&mdash;</dd></div><div><dt>@(createExpense ? "Amount Paid" : "Recorded Paid")</dt><dd id="expense-summary-paid">&mdash;</dd></div><div><dt>@(createExpense ? "Balance Due" : "Recorded Outstanding")</dt><dd id="expense-summary-outstanding">&mdash;</dd></div><div><dt>Payment Status</dt><dd id="expense-summary-payment">@(createExpense ? "Not set" : "Not recorded")</dd></div>@if(!createExpense){<div><dt>Category</dt><dd id="expense-summary-category">&mdash;</dd></div><div><dt>Payee</dt><dd id="expense-summary-payee">&mdash;</dd></div><div><dt>Attachments</dt><dd id="expense-summary-attachments">0</dd></div>}</dl><div id="expense-summary-gst" hidden><h3>GST Details</h3><dl class="expense-summary-values"><div><dt>GST Rate</dt><dd id="expense-summary-gst-rate"></dd></div><div><dt>Taxable Amount</dt><dd id="expense-summary-taxable"></dd></div><div><dt>GST Included</dt><dd id="expense-summary-gst-amount"></dd></div></dl></div></section>
<section class="card card-body expense-actions"><h2>Actions</h2><button type="button" id="expense-record" class="btn btn-primary" hidden>Record Expense</button><button type="button" id="expense-post" class="btn btn-primary" hidden>Record Expense</button><button type="submit" form="expense-form" id="expense-save" disabled class="btn btn-dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12l4 4v12a2 2 0 0 1-2 2ZM7 3v5h8V3M7 21v-8h10v8" /></svg><span id="expense-save-label">Save Draft</span></button><a href="/Expenses" class="@(createExpense ? "expense-back-link" : "btn btn-outline-secondary")">@if(createExpense){<span aria-hidden="true">&#8592;</span>}Back to Expenses</a><details id="expense-more" hidden><summary>More Actions</summary><button type="button" id="expense-correct-open" class="btn btn-outline-secondary">Correct Expense</button><button type="button" id="expense-cancel-open" class="btn btn-outline-secondary">Cancel Expense</button><button type="button" id="expense-cancel" class="btn btn-outline-danger" hidden>Confirm Cancellation</button></details></section>
<section id="expense-audit" class="card card-body" hidden><h2>Audit Information</h2><dl class="expense-summary-values"><div><dt>Created by</dt><dd id="expense-created-by"></dd></div><div><dt>Created at</dt><dd id="expense-created-at"></dd></div><div><dt>Last saved</dt><dd id="expense-updated-at"></dd></div></dl></section></aside></div>
<section id="expense-payment-history" class="card card-body" hidden><h2>Payment History</h2><p id="expense-payments-empty" class="expense-muted">No payments recorded yet.</p><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Method</th><th>Amount</th><th>Reference</th><th>Actor</th><th>Actions</th></tr></thead><tbody id="expense-payments"></tbody></table></div></section>
<section id="expense-correction-history" class="card card-body" hidden><h2>Correction History</h2><p id="expense-history-empty" class="expense-muted">No expense events recorded yet.</p><div class="table-responsive"><table class="table"><thead><tr><th>Version</th><th>Action</th><th>At</th><th>Actor</th><th>Reason</th><th>Expense Amount</th></tr></thead><tbody id="expense-history"></tbody></table></div></section>
<dialog id="expense-payment-dialog" aria-labelledby="expense-payment-title">
<form id="expense-later-payment" data-unsaved-context="Expense payment" novalidate>
    <header class="expense-master-heading"><div><h2 id="expense-payment-title">Record Payment</h2><p id="expense-later-balance"></p></div><button id="expense-payment-x" type="button" class="expense-master-x sf-dialog-close" aria-label="Close payment popup" data-local-cancel><svg viewBox="0 0 24 24" fill="none" stroke="#25334b" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></header>
    <div class="expense-master-body">
        <p id="expense-later-error" class="expense-error" role="alert" hidden></p>
        <div><label for="expense-later-amount">Amount Paid (₹) *</label><input id="expense-later-amount" class="form-control" type="number" min="0.01" step="0.01" required /></div>
        <div><label for="expense-later-method">Payment Method *</label><select id="expense-later-method" class="form-select" required>@foreach(var method in paymentMethods){<option value="@method.Code">@method.Label</option>}</select></div>
        <div><label for="expense-later-date">Payment Date *</label><input id="expense-later-date" class="form-control" type="date" required /></div>
        <div><label for="expense-later-reference">Transaction Reference (optional)</label><input id="expense-later-reference" class="form-control" maxlength="150" /></div>
    </div>
    <footer class="expense-master-actions"><button id="expense-payment-cancel" type="button" class="btn btn-outline-secondary" data-local-cancel>Cancel</button><button id="expense-payment-save" type="submit" class="btn btn-primary">Save Payment</button></footer>
</form></dialog>
<dialog id="expense-master-dialog" aria-labelledby="expense-master-title">
<form id="expense-master-form" data-unsaved-context="Expense category or payee" novalidate>
    <header class="expense-master-heading">
        <span class="expense-master-icon" aria-hidden="true"><svg id="expense-master-payee-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" hidden><circle cx="10" cy="7" r="4" /><path d="M3 21v-3a6 6 0 0 1 10-4M18 13v8m-4-4h8" /></svg><svg id="expense-master-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10V7a2 2 0 0 0-2-2h-6l-2-2H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8M18 13v8m-4-4h8" /></svg></span>
        <div><h2 id="expense-master-title">Add Expense Category</h2><p id="expense-master-subtitle">Create a category to organize your expenses.</p></div>
        <button type="button" id="expense-master-x" class="expense-master-x sf-dialog-close" aria-label="Close popup" data-local-cancel><svg viewBox="0 0 24 24" fill="none" stroke="#25334b" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    </header>
    <div class="expense-master-body">
        <p id="expense-master-error" class="expense-error" role="alert" hidden></p>
        <div><label id="expense-master-name-label" for="expense-master-name">Category Name *</label><input id="expense-master-name" class="form-control" maxlength="150" placeholder="e.g., Shop Rent, Electricity" required /></div>
        <div id="expense-master-contact-field" hidden><label for="expense-master-contact">Mobile Number (Optional)</label><input id="expense-master-contact" class="form-control" type="tel" inputmode="numeric" maxlength="10" pattern="[6-9][0-9]{9}" placeholder="Enter mobile number" disabled /></div>
    </div>
    <footer class="expense-master-actions"><button type="button" id="expense-master-close" class="btn btn-outline-secondary" data-local-cancel>Cancel</button><button id="expense-master-save" class="btn btn-primary" type="submit">Save Category</button></footer>
</form></dialog><div class="expense-assistant-dock"></div></div>
