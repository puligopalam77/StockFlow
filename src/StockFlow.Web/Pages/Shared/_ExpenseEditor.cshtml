@inject StockFlow.Application.Common.BusinessScope Scope
<div id="expenses" data-mode="editor" data-id="@Context.Request.Query["id"]" data-scope="@Scope.TenantId.@Scope.UserId.@Scope.StoreId.@Scope.LocationId.@Scope.BusinessProfileCode">
<p><a href="/Expenses">Back to Expenses</a> · <strong id="expense-state">Loading…</strong></p><div id="expense-message" role="alert" hidden></div><button id="expense-retry" class="btn btn-dark" hidden>Retry unchanged request</button>
<div class="expense-grid"><form id="expense-form" class="card card-body"><fieldset id="expense-fields" disabled>
<label>Category<select id="expense-category" class="form-select" required></select></label><button type="button" data-master="CATEGORY" class="btn btn-sm btn-outline-secondary">Add Category</button>
<label>Payee<select id="expense-payee" class="form-select" required></select></label><button type="button" data-master="PAYEE" class="btn btn-sm btn-outline-secondary">Add Payee</button>
<label>Incurred date<input id="expense-incurred" class="form-control" type="date" required /></label><label>Amount (₹)<input id="expense-amount" class="form-control" type="number" min="0.01" max="9999999999.99" step="0.01" required /></label>
<label>Description<textarea id="expense-description" class="form-control" maxlength="2000" required></textarea></label><label>Correction / cancellation reason<textarea id="expense-reason" class="form-control" maxlength="1000"></textarea></label>
<button id="expense-save" class="btn btn-dark">Save Draft</button><button type="button" id="expense-post" class="btn btn-dark" hidden>Post Expense</button><button type="button" id="expense-cancel" class="btn btn-outline-danger" hidden>Cancel Expense</button>
</fieldset><p class="small mt-2">Posting records an operating expense. It creates no stock movement or eligible GST ITC.</p></form>
<div><form id="expense-payment" class="card card-body" hidden><h2>Payments</h2><p id="expense-balance"></p>
<label>Action<select id="expense-payment-action" class="form-select"><option value="PAY">Payment</option><option value="REFUND">Refund received</option></select></label>
<label>Paid / returned date<input id="expense-paid-date" class="form-control" type="date" required /></label><label>Amount (₹)<input id="expense-payment-amount" class="form-control" type="number" min="0.01" step="0.01" max="9999999999.99" required /></label>
<label>Method<select id="expense-method" class="form-select">@foreach(var method in new[]{"CASH","UPI","DEBIT_CARD","CREDIT_CARD","BANK_TRANSFER"}){<option value="@method">@method.Replace('_',' ')</option>}</select></label>
<label>Reference<input id="expense-reference" class="form-control" maxlength="150" /></label><label>Refund / reversal reason<input id="expense-payment-reason" class="form-control" maxlength="1000" /></label><button class="btn btn-dark">Record</button>
<p class="small">Recorded payment evidence only. Provider settlement is not verified. Reversals below use this form's date and reason.</p></form>
<form id="expense-attachment-form" class="card card-body mt-3" hidden enctype="multipart/form-data"><h2>Supporting receipts</h2><label>PDF, PNG or JPEG, up to 5 MB<input id="expense-file" class="form-control" type="file" accept="application/pdf,image/png,image/jpeg" required /></label><button class="btn btn-dark">Attach Receipt</button><p class="small">If the result is unknown, select the same file and retry before changing attachments.</p></form><ul id="expense-attachments"></ul></div></div>
<div class="card card-body mt-3"><h2>Payment history</h2><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Method</th><th>Amount</th><th>Reference</th><th></th></tr></thead><tbody id="expense-payments"></tbody></table></div></div>
<div class="card card-body mt-3"><h2>Correction history</h2><div class="table-responsive"><table class="table"><thead><tr><th>Version</th><th>Action</th><th>At</th><th>Actor</th><th>Reason</th><th>Amount</th></tr></thead><tbody id="expense-history"></tbody></table></div></div>
<dialog id="expense-master-dialog"><form id="expense-master-form"><h2 id="expense-master-title">New Category</h2><label>Name<input id="expense-master-name" class="form-control" maxlength="150" required /></label><button class="btn btn-dark">Save</button><button type="button" id="expense-master-close" class="btn btn-outline-secondary">Close</button></form></dialog>
</div>
