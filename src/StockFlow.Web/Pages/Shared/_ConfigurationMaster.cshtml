@model string
@inject StockFlow.Application.Common.BusinessScope CatalogScope
@{
    var singular = Model switch { "Categories" => "Category", "Brands" => "Brand", "Suppliers" => "Supplier", _ => "Product" };
    var module = Model.ToUpperInvariant();
}
<div id="master-data" data-module="@Model.ToLowerInvariant()" data-can-products="@Access.Can("PRODUCTS").ToString().ToLowerInvariant()" data-can-edit="@Access.Can(module,"EDIT").ToString().ToLowerInvariant()" data-can-disable="@Access.Can(module,"DELETE").ToString().ToLowerInvariant()">
    <div class="configuration-heading">
        <h2>@Model</h2>
        <div class="d-flex align-items-center flex-wrap gap-2">
        @if(Model=="Products" && Access.Can("BARCODES","VIEW")){<a href="/Labels" class="btn btn-outline-secondary">Barcode Labels</a>}
        @if (Access.Can(module,"CREATE")) {
        @if (Model == "Categories") {
        <div class="category-create-actions"><button id="add-record" class="btn category-primary" type="button" aria-haspopup="dialog" aria-controls="editor">+ Add Category</button></div>
        } else {
        <button id="add-record" class="btn btn-primary" type="button" aria-haspopup="dialog" aria-controls="@(Model == "Products" ? "purchase-registration" : "editor")">+ Add @singular</button>
        }
        }
        </div>
    </div>
    <div id="master-message" class="alert d-none" role="status" aria-live="polite">
    </div>
    <section id="master-list" aria-label="@Model list">
        @if (Model != "Products" && Model != "Suppliers") {
            <h3>Saved @Model</h3>
        }
        <div class="row g-3 mb-3">
            <div class="col-md-8">
                <label for="master-search" class="form-label">@(Model == "Categories" ? "Search Categories" : "Search " + Model.ToLowerInvariant())</label>
                <input id="master-search" type="search" class="form-control" placeholder="@(Model switch { "Products" => "Search by product name, product code or SKU...", "Categories" => "Search by category name or code...", _ => "Search " + Model.ToLowerInvariant() })" />
            </div>
            <div class="col-md-4">
                <label for="status-filter" class="form-label">Status</label>
                <select id="status-filter" class="form-select">
                    <option value="false">@(Model == "Suppliers" ? "All Statuses" : "All records")</option>
                    <option value="true">@(Model == "Suppliers" ? "Active" : "Active only")</option>
                    @if (Model == "Suppliers") { <option value="inactive">Inactive</option> }
                </select>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead id="master-head">
                </thead>
                <tbody id="master-rows">
                </tbody>
            </table>
        </div>
    </section>
    <partial name="_MasterEditor" model="Model" />
    <dialog data-sf-dialog="compact" id="deactivate-dialog" class="configuration-dialog" aria-labelledby="deactivate-title">
        <h2 id="deactivate-title">@(Model == "Categories" ? "Deactivate Category?" : "Stop using this " + singular.ToLowerInvariant() + "?")</h2>
        <p>@(Model == "Categories" ? "This category will no longer be available for new product registration." : "This record will no longer be available for new entries. Its saved history will stay.")</p>
        <div class="configuration-dialog-actions">
            <button type="button" id="cancel-deactivate" class="btn btn-outline-secondary">Cancel</button>
            <button type="button" id="confirm-deactivate" class="btn btn-dark">@(Model == "Categories" ? "Deactivate Category" : "Stop using this record")</button>
        </div>
    </dialog>
</div>
