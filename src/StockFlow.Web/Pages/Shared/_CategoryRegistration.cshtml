<dialog data-sf-dialog="form" id="editor" class="configuration-dialog category-registration" aria-labelledby="editor-title" aria-describedby="editor-help">
    <header class="category-registration-heading"><div><h2 id="editor-title">Add Category</h2><p id="editor-help">Create a new category or subcategory for your business.</p></div><button id="close-editor" type="button" aria-label="Close registration">&#215;</button></header>
    <div id="editor-message" class="alert d-none" role="alert"></div>
    <form id="master-form" novalidate>
        <div class="category-registration-content">
            <section id="category-panel-basic">
                <section class="category-registration-card"><div id="form-fields" class="row g-3"></div></section>
            </section>
        </div>
        <footer class="category-registration-footer"><button type="button" id="cancel-edit" class="btn btn-outline-secondary">Cancel</button><button type="submit" id="category-save" class="btn btn-primary">Save Category</button></footer>
    </form>
</dialog>
