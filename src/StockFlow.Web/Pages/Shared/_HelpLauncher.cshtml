<button id="help-open" type="button" class="sf-help-open" aria-label="Ask StockBot" aria-describedby="stockbot-launcher-tooltip" aria-haspopup="dialog" aria-controls="help-panel" data-no-translate>
    <img class="sf-stockbot-avatar" src="~/images/assistant-robot-cyan.png" asp-append-version="true" width="26" height="26" alt="" />
    <img class="sf-stockbot-hand" src="~/images/assistant-robot-cyan.png" asp-append-version="true" width="26" height="26" alt="" aria-hidden="true" />
    <svg class="sf-stockbot-expression" viewBox="0 0 1254 1254" aria-hidden="true" focusable="false">
        <defs>
            <clipPath id="sf-stockbot-body-clip" clipPathUnits="objectBoundingBox">
                <path clip-rule="evenodd" d="M0 0H1V1H0Z M.74 .33H1V.65H.87L.78 .61 .72 .54Z" />
            </clipPath>
        </defs>
        <g class="sf-stockbot-shine" fill="none" stroke="#fff" stroke-linecap="round">
            <path d="M179 269 Q440 102 700 236" stroke-width="18" />
            <path d="M446 921 A60 60 0 0 1 535 950" stroke-width="10" />
        </g>
        <g class="sf-stockbot-blink">
            <ellipse cx="318" cy="487" rx="106" ry="80" fill="#061626" />
            <ellipse cx="636" cy="508" rx="103" ry="79" fill="#071827" />
            <g fill="none" stroke="#78ffff" stroke-width="11" stroke-linecap="round">
                <path d="M250 510 Q318 532 385 513" />
                <path d="M571 533 Q638 554 704 535" />
            </g>
        </g>
    </svg>
    <span id="stockbot-launcher-tooltip" class="sf-stockbot-tooltip" role="tooltip">Ask StockBot</span>
</button>
