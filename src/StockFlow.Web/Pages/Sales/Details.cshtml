@page "{id:long}"
@model StockFlow.Web.Pages.Sales.DetailsModel
@inject StockFlow.Application.Common.BusinessScope BusinessScope
@inject Microsoft.Extensions.Options.IOptions<StockFlow.Application.Common.ShopTimeOptions> ShopTime
@{ ViewData["Title"] = "Customer bill"; }
<div class="sale-detail-screen">
<h1 id="sale-title" class="h3">Customer bill</h1>
<p permission-module="EWAY_BILLS"><a asp-page="/EWayBills/Prepare" asp-route-saleId="@RouteData.Values["id"]" class="btn btn-sm btn-outline-secondary">Prepare / find E-Way Bill</a></p>
<p class="small text-muted">Finalized invoice snapshots are read-only. Collections and returns remain linked to this invoice.</p>
@if(Access.Can("GST_REPORTS")){<p><a href="/Reports/Gst" class="btn btn-sm btn-outline-secondary">GST working records &amp; linked tax notes</a></p>}
<a id="view-invoice" class="btn btn-primary mb-3" hidden>View / print invoice</a>
<div id="sale-message" class="alert alert-danger" role="status" hidden>
</div>
<dl id="sale-header" class="row">
</dl>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Product / serial / unit ID</th>
                <th>SKU</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Discount</th>
                <th>Tax %</th>
                <th>Total</th>
                <th>Warranty</th>
            </tr>
        </thead>
        <tbody id="sale-lines">
        </tbody>
    </table>
</div>
<h2 class="h5">Payments and money still due</h2>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Payment date</th>
                <th>Mode</th>
                <th>Amount</th>
                <th>Reference</th>
            </tr>
        </thead>
        <tbody id="sale-payments">
        </tbody>
    </table>
</div>
<p id="sale-payment-summary">
</p>
<div id="sale-operations" data-time-zone="@ShopTime.Value.TimeZoneId" data-can-edit="@Access.Can("SALES","COLLECT").ToString().ToLowerInvariant()" data-can-return="@Access.Can("SALES","RETURN").ToString().ToLowerInvariant()">
    <section class="card card-body my-3">
        <h2 class="h5">Account activity</h2>
        <p id="sale-account-summary">
        </p>
        <div id="sale-operation-history">
        </div>
        <div id="sale-return-history"></div>
        <div permission-module="SALES" permission-action="COLLECT">
@if(Access.Can("SALES","COLLECT")){<details id="sale-collect-payment">
            <summary>Collect Due Payment</summary>
            <p>Record a payment received now against this invoice. This does not create another sale. Electronic receipts require confirmation that funds were received.</p>
            <form id="customer-payment-form" class="row g-2 mt-1">
                <div class="col-md-3">
                    <label class="form-label">Amount</label>
                    <input id="customer-payment-amount" type="number" min="0.01" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Method</label>
                    <select id="customer-payment-mode" class="form-select">
                        <option value="CASH">Cash</option>
                        <option value="CARD">Card</option>
                        <option value="CARD:DEBIT">Debit Card</option>
                        <option value="CARD:CREDIT">Credit Card</option>
                        <option value="UPI">UPI</option>
                        <option value="BANK">Bank payment</option>
                        <option value="CHEQUE">Cheque</option>
                    </select>
                </div>
                <div class="col-md-12"><label><input id="customer-payment-confirmed" type="checkbox" required /> I confirm this payment has been received. A transaction reference alone is not proof of payment.</label><p class="small">Payment date is recorded by the server when saved; the invoice date remains unchanged.</p></div>
                <div class="col-md-4">
                    <label class="form-label">Reference</label>
                    <input id="customer-payment-reference" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-2 align-self-end">
                    <button class="btn btn-primary">Record payment</button>
                </div>
            </form>
        </details>}
    </div>
</section>
<div permission-module="SALES" permission-action="RETURN">
@if(Access.Can("SALES","RETURN")){<section class="card card-body my-3">
    <details id="sale-return-details">
        <summary>Return, refund or exchange</summary>
        <form id="sale-return-form" class="row g-2 mt-1">
            <div class="col-md-5">
                <label class="form-label">Invoice item</label>
                <select id="sale-return-item" class="form-select" required>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Quantity</label>
                <input id="sale-return-quantity" type="number" min="1" value="1" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Stock condition</label>
                <select id="sale-return-disposition" class="form-select">
                    <option value="RESTOCK">Resellable</option>
                    <option value="DAMAGED">Damaged</option>
                    <option value="SUPPLIER_RETURN">Return to supplier</option>
                    <option value="SERVICE_HOLD">Hold for service</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Settlement</label>
                <select id="sale-return-refund-mode" class="form-select">
                    <option value="CREDIT_ADJUSTMENT">Credit adjustment</option>
                    <option value="EXCHANGE">Exchange</option>
                    <option value="CASH">Cash</option>
                    <option value="CARD">Card</option>
                    <option value="UPI">UPI</option>
                    <option value="BANK">Bank payment</option>
                    <option value="NONE">None</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Refund paid now</label>
                <input id="sale-return-refund" type="number" min="0" step="0.01" value="0" class="form-control" />
            </div>
            <div class="col-md-7">
                <label class="form-label">Reason</label>
                <input id="sale-return-notes" class="form-control" maxlength="2000" required />
            </div>
            <div class="col-md-2 align-self-end">
                <button class="btn btn-warning">Save customer return</button>
            </div>
        </form>
        <p class="small mt-2">For an exchange, post this return and create the replacement sale. The original invoice and serial history remain traceable.</p>
    </details>
</section>}
</div>
<div permission-module="SALES" permission-action="FULFIL">
@if(Access.Can("SALES","EDIT")){<section class="card card-body my-3">
    <h2 class="h5">Delivery, installation and trade-in</h2>
    <details>
        <summary>Record delivery or installation update</summary>
        <form id="fulfilment-form" class="row g-2 mt-1">
            <div class="col-md-3">
                <label class="form-label">Work</label>
                <select id="fulfilment-type" class="form-select">
                    <option value="DELIVERY">Delivery</option>
                    <option value="INSTALLATION">Installation</option>
                    <option value="DELIVERY_INSTALLATION">Delivery installation</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select id="fulfilment-status" class="form-select">
                    <option value="SCHEDULED">Scheduled</option>
                    <option value="IN_PROGRESS">In progress</option>
                    <option value="COMPLETED">Completed</option>
                    <option value="CANCELLED">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Scheduled</label>
                <input id="fulfilment-date" type="datetime-local" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Address</label>
                <input id="fulfilment-address" class="form-control" maxlength="1000" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Contact</label>
                <input id="fulfilment-contact" class="form-control" maxlength="30" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Technician</label>
                <input id="fulfilment-technician" class="form-control" maxlength="150" />
            </div>
            <div class="col-md-2 align-self-end">
                <button class="btn btn-primary">Record update</button>
            </div>
        </form>
    </details>
    <details class="mt-2" hidden="@(BusinessScope.BusinessProfileCode != "ELECTRICAL")">
        <summary>Record an old battery or geyser exchange</summary>
        <form id="trade-in-form" class="row g-2 mt-1">
            <div class="col-md-2">
                <label class="form-label">Type</label>
                <input id="trade-in-type" value="BATTERY" class="form-control" maxlength="50" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Brand / model</label>
                <input id="trade-in-model" class="form-control" maxlength="200" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Serial</label>
                <input id="trade-in-serial" class="form-control" maxlength="150" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select id="trade-in-status" class="form-select">
                    <option value="RECEIVED">Received</option>
                    <option value="VALUED">Valued</option>
                    <option value="RESOLD">Resold</option>
                    <option value="RECYCLED">Recycled</option>
                    <option value="DISPOSED">Disposed</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Value of the old item</label>
                <input id="trade-in-allowance" type="number" min="0" step="0.01" value="0" class="form-control" />
            </div>
            <div class="col-md-1 align-self-end">
                <button class="btn btn-primary">Record</button>
            </div>
        </form>
        <p class="small mt-2">Enter the allowance as a sale discount during billing when it should reduce the invoice.</p>
    </details>
</section>}
</div>
</div>
<a asp-page="Index">Back to Customer Bills</a>
</div>
@section Styles { <link rel="stylesheet" href="~/css/sales-details.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/sales-common.js" asp-append-version="true"></script><script src="~/js/sales-details.js" asp-append-version="true"></script><script src="~/js/shop-operations.js" asp-append-version="true"></script> }
