@page
@model StockFlow.Web.Pages.Admin.PilotModel
@inject StockFlow.Application.Common.BusinessScope Scope
@{ ViewData["Title"] = "Shop pilot checklist"; }
<partial name="_AdminNavigation" />
<h1>Shop onboarding &amp; pilot checklist</h1>
<p>Complete these checks at the shop before regular use. Software tests cannot verify a physical scanner, printer or staff training.</p>
<details class="card card-body mb-3"><summary>Hosting &amp; database recovery status</summary>
    <p class="small">Database evidence applies to this deployment's tenant, not a separate backup of this shop. Missing or stale evidence requires operator review.</p>
    <p id="pilot-operations" role="status">Status has not been checked.</p>
    <button id="pilot-operations-load" type="button" class="btn btn-sm btn-outline-secondary">Check status</button>
    <p class="small">Migration indicators detect capabilities only. They do not certify the complete migration history. A database restore test does not verify uploaded assets, keys, offsite retention or business balances.</p>
</details>
<div id="pilot-workspace" data-profile="@Scope.BusinessProfileCode" data-storage-key="stockflow.pilot.v2.@Scope.TenantId.@Scope.UserId.@Scope.StoreId.@Scope.LocationId.@Scope.BusinessProfileCode">
    <p><strong>@Scope.LocationName</strong> · @StockFlow.Application.Common.BusinessProfiles.Name(Scope.BusinessProfileCode)</p>
    <p class="alert alert-info">This checklist is kept in this browser. Export and keep a copy with the owner. Do not enter passwords or customer information.</p>
    <p class="small">Confirmations are operator statements, not automated certification. Each passed item needs dated evidence. Opening debtor/creditor imports and independent shop profiles remain unavailable; they cannot be signed off here. Earlier browser checklists are retained under their original key and are not copied across shop/profile contexts.</p>
    <div id="pilot-message" role="alert" hidden></div>
    <form id="pilot-form" class="card card-body">
        <div class="row g-3">
            @foreach (var field in new[] { ("store", "Shop / location"), ("operator", "Tested by"), ("build", "Build / deployment date"), ("workstation", "Workstation / browser"), ("scanner", "Scanner model / Enter setting"), ("printer", "Printer / label size"), ("backup", "Backup and restore-test evidence") })
            { <div class="col-md-6"><label for="pilot-@field.Item1" class="form-label">@field.Item2 *</label><input id="pilot-@field.Item1" class="form-control" maxlength="200" required /></div> }
        </div>
        <div id="pilot-checks"></div>
        <p id="pilot-progress" role="status" class="mt-3"></p>
        <button id="pilot-sign" type="submit" class="btn btn-primary">Record pilot sign-off</button>
    </form>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <button id="pilot-export" type="button" class="btn btn-outline-primary">Export checklist</button>
        <button id="pilot-print" type="button" class="btn btn-outline-secondary">Print checklist</button>
        <a href="/CashClosing" permission-module="REPORTS" class="btn btn-outline-secondary">Daily cash closing</a>
    </div>
</div>
@section Styles { <link rel="stylesheet" href="~/css/shop-readiness.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/shop-pilot.js" asp-append-version="true"></script> }
