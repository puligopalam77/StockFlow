@page
@{ViewData["Title"]="Shops & Locations";}
<div id="stores-workspace" class="sf-list-screen" data-user-access="@(Access.Can("USER_MANAGEMENT","VIEW")&&Access.Can("STORES","MANAGE_ACCESS"))" data-gst="@Access.Can("GST_SETTINGS","VIEW")" data-gst-edit="@Access.Can("GST_SETTINGS","EDIT")">
<header class="stores-heading"><div><h1>Shops &amp; Locations</h1><p>Manage your business shops and stock locations.</p></div><div class="stores-actions"><button id="store-add" type="button" class="btn btn-primary" disabled>+ Add Shop</button><button id="location-add" type="button" class="btn btn-outline-secondary" disabled>+ Add Stock Location</button></div></header>
<div id="branch-message" class="alert" role="status" data-keep-banner hidden></div>
<div id="stores-capability" class="stores-notice" hidden></div>
<nav class="stores-tabs" role="tablist" aria-label="Shops and stock locations"><button id="shops-tab" type="button" role="tab" aria-selected="true" aria-controls="shops-panel">Shops</button><button id="stock-locations-tab" type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="stock-locations-panel">Stock Locations</button></nav>
<section id="shops-panel" role="tabpanel" aria-labelledby="shops-tab">
<section class="stores-kpis" aria-label="Authorized directory counts">
@foreach(var kpi in new[]{("stores-count","Total Shops","pink"),("active-stores-count","Active Shops","green"),("inactive-stores-count","Inactive Shops","orange"),("missing-floor-count","Active Shops Without Sales Floor","blue")}){<article class="stores-kpi @kpi.Item3"><h2>@kpi.Item2</h2><strong id="@kpi.Item1">&mdash;</strong></article>}
</section><p class="stores-help">Counts cover the authorized directory scope. A sales floor or GST mapping alone does not establish billing readiness.</p>
<form id="store-filters" class="sf-filter-bar" role="search"><div class="store-field"><label for="store-search">Find shops</label><input id="store-search" type="search" maxlength="150" placeholder="Shop name or code" class="form-control"/></div><div class="store-field"><label for="store-status">Status</label><select id="store-status" class="form-select"><option value="ALL">All statuses</option><option value="ACTIVE">Active</option><option value="INACTIVE">Inactive</option></select></div><button class="btn btn-outline-secondary" type="submit">Search</button><button class="btn btn-outline-secondary" id="store-reset" type="button">Reset Filters</button><button class="btn btn-outline-secondary" id="store-refresh" type="button">Refresh Directory</button></form>
<section class="stores-directory"><div class="stores-table-scroll"><table class="table"><thead><tr><th>Shop / Code</th><th>Type</th><th>Business Profile</th><th>City / State</th><th>Active Locations</th><th>GST Mapping</th><th>Setup Readiness</th><th>Status</th><th>Actions</th></tr></thead><tbody id="store-rows"></tbody></table></div><p id="store-empty" hidden>No matching shops. Adjust filters or add a shop.</p><div id="store-pager"></div></section>
</section>
<section id="stock-locations-panel" role="tabpanel" aria-labelledby="stock-locations-tab" hidden><h2>Stock Locations</h2><p class="stores-help">Active locations in your authorized business. Add shop floors, stock rooms or central warehouses using Add Stock Location.</p><p class="stores-help"><strong id="locations-count">&mdash;</strong> stock locations · <strong id="warehouses-count">&mdash;</strong> warehouse locations</p><div class="stores-table-scroll"><table class="table"><thead><tr><th>Shop</th><th>Location</th><th>Type</th></tr></thead><tbody id="stock-location-rows"></tbody></table></div><p id="stock-location-status" role="status">Loading locations...</p></section>
<dialog data-sf-dialog="large" id="store-dialog" aria-labelledby="store-dialog-title"><header><h2 id="store-dialog-title">Add Shop</h2><button type="button" class="stores-close" data-close="store-dialog" aria-label="Close store editor">&times;</button></header>
<partial name="~/Pages/Admin/Stores/_ShopForm.cshtml" /></dialog>
<dialog data-sf-dialog="medium" id="location-dialog" aria-labelledby="location-dialog-title"><header><h2 id="location-dialog-title">Add Stock Location</h2><button type="button" class="stores-close" data-close="location-dialog" aria-label="Close location editor">&times;</button></header><form id="location-form" data-unsaved-context="New stock location"><div class="stores-dialog-body"><div id="location-form-error" class="alert alert-danger" role="alert" data-keep-banner hidden></div><div class="stores-form-grid"><div class="store-field"><label for="location-store">Store / owning context</label><select id="location-store" name="storeId" class="form-select"></select></div><div class="store-field"><label for="location-name">Location name *</label><input id="location-name" name="locationName" class="form-control" required maxlength="150"/></div><div class="store-field"><label for="location-type">Location type *</label><select id="location-type" name="locationType" class="form-select"><option value="WAREHOUSE">Warehouse</option><option value="STOCKROOM">Stock room</option><option value="SALES_FLOOR">Shop floor</option><option value="BACKROOM">Back room</option><option value="SERVICE_CENTER">Repair centre</option></select></div></div><p class="stores-help">Central warehouses have no retail store. Locations are stock boundaries, not separate GST registrations. No inventory movement is posted by adding a location.</p></div><footer><button type="button" class="btn btn-outline-secondary" data-close="location-dialog">Cancel</button><button id="location-save" type="submit" class="btn btn-primary">Add Stock Location</button></footer></form></dialog>
<dialog data-sf-dialog="large" id="store-details-dialog" aria-labelledby="store-details-title"><header><h2 id="store-details-title">Store Details</h2><button type="button" class="stores-close" data-close="store-details-dialog" aria-label="Close store details">&times;</button></header><div id="store-details-body" class="stores-dialog-body"></div><footer><button type="button" class="btn btn-outline-secondary" data-close="store-details-dialog">Close</button></footer></dialog>
<div class="stores-assistant-dock"></div></div>
@section Styles {<link rel="stylesheet" href="~/css/store-management.css" asp-append-version="true"/>}
@section Scripts {<script src="~/js/branches.js" asp-append-version="true"></script>}
