@page
@{ViewData["Title"]="Roles & Permissions";}
<div id="roles-workspace" class="roles-screen" data-mode="list" data-edit="@Access.Can("ROLE_MANAGEMENT","MANAGE_PERMISSIONS").ToString().ToLowerInvariant()">
 <header class="roles-heading"><div><h1>Roles &amp; Permissions</h1><p>Manage staff roles and access permissions.</p></div>@if(Access.Can("ROLE_MANAGEMENT","MANAGE_PERMISSIONS")){<a class="btn btn-primary" href="/Admin/Roles/Create">+ Add Role</a>}</header>
 <div id="role-message" role="status" class="alert" hidden></div>
 <nav class="role-tabs" aria-label="Role configuration"><a href="/Admin/Roles" aria-current="page">Roles</a><a href="/Admin/Roles/Templates">Role Templates</a></nav>
 <section class="role-kpis" aria-label="Role totals"><article class="pink"><svg aria-hidden="true"><use href="/images/icons.svg#users" /></svg><div><h2>Total Roles</h2><strong id="roles-total">—</strong></div></article><article class="green"><svg aria-hidden="true"><use href="/images/icons.svg#report-check" /></svg><div><h2>Active Roles</h2><strong id="roles-active">—</strong></div></article><article class="orange"><svg aria-hidden="true"><use href="/images/icons.svg#clock" /></svg><div><h2>Inactive Roles</h2><strong id="roles-inactive">—</strong></div></article></section>
 <form id="role-filters" class="role-filters"><label for="role-search">Find roles</label><input id="role-search" class="form-control" type="search" maxlength="100" placeholder="Search role name or description"/><select id="role-filter-status" class="form-select" aria-label="Role status"><option value="ALL">All statuses</option><option value="ACTIVE">Active</option><option value="INACTIVE">Inactive</option></select><button id="role-filter-reset" type="button" class="btn btn-outline-secondary">Reset Filters</button></form>
 <section class="role-table-card"><div class="role-table-scroll"><table class="table"><thead><tr><th>Role Name</th><th>Description</th><th>Users</th><th>Status</th><th>Actions</th></tr></thead><tbody id="role-list"></tbody></table></div><p id="role-empty" hidden>No matching roles.</p><p id="role-list-count" class="roles-help" role="status"></p></section>
</div>
@section Styles{<link rel="stylesheet" href="~/css/role-management.css" asp-append-version="true"/>}
@section Scripts{<script src="~/js/role-management.js" asp-append-version="true"></script>}
