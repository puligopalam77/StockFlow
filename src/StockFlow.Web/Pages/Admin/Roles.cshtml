@page
@{ ViewData["Title"]="Roles and permissions"; }
<div data-grants="@System.Text.Json.JsonSerializer.Serialize(Access.User!.Permissions.ToDictionary(p=>p.ModuleCode,p=>p.SupportedActions.Where(p.Allows).ToArray()))" id="admin-roles" data-edit="@Access.Can("ROLE_MANAGEMENT","MANAGE_PERMISSIONS").ToString().ToLowerInvariant()">
    <h1>Role templates</h1>
    <div id="admin-message" role="status" aria-live="polite">
    </div>
@if(Access.Can("ROLE_MANAGEMENT","MANAGE_PERMISSIONS")){<button id="create-role" type="button" class="btn btn-outline-primary mb-3">Add role</button>}
    <label for="role">Role template</label>
    <select id="role" class="form-select mb-3">
    </select>
@if(Access.Can("ROLE_MANAGEMENT","MANAGE_PERMISSIONS")){<button type="button" class="btn btn-outline-secondary" data-matrix="reset">Reset unsaved changes</button>}
    <details class="admin-permissions">
        <summary>Authenticator policy</summary>
        <label class="d-block my-3">
            <input id="role-two-factor" type="checkbox" /> Require authenticator for this role</label>
        <button id="save-role-security" type="button" class="btn btn-outline-secondary">Save role security rules</button>
    </details>
    <div id="permission-matrix" class="mt-3">
    </div>
@if(Access.Can("ROLE_MANAGEMENT","MANAGE_PERMISSIONS")){<button id="save-role" class="btn btn-primary" type="button">Save staff role</button>}
</div>
@section Scripts {<script src="~/js/common/permission-editor.js" asp-append-version="true"></script><script src="~/js/admin-security.js" asp-append-version="true"></script>}


@section Styles {<link rel="stylesheet" href="~/css/admin-security.css" asp-append-version="true" />}
