<div id="roles-workspace" class="roles-screen" data-mode="@ViewData["RoleMode"]" data-role-id="@ViewContext.RouteData.Values["id"]" data-edit="@Access.Can("ROLE_MANAGEMENT","MANAGE_PERMISSIONS").ToString().ToLowerInvariant()" data-grants="@System.Text.Json.JsonSerializer.Serialize(Access.User!.Permissions.ToDictionary(p=>p.ModuleCode,p=>p.SupportedActions.Where(p.Allows).ToArray()))">
 <header class="roles-heading"><div><h1>@ViewData["Title"]</h1><p>Create and manage a staff role and its permission template.</p></div><div class="role-heading-actions"><span id="role-updated" hidden></span>@if(Access.Can("AUDIT_LOGS") && ViewData["RoleMode"]?.ToString()!="create"){<a class="btn btn-outline-secondary" href="/Admin/AuditLogs">View Audit Log</a>}<a class="btn btn-outline-secondary" href="/Admin/Roles">Back to Roles &amp; Permissions</a></div></header>
 <div id="role-message" class="alert" role="alert" hidden></div>
 <form id="role-editor-form" data-unsaved-context="role details and permissions" hidden>
  <section class="role-card"><h2><svg aria-hidden="true"><use href="/images/icons.svg#users"/></svg>1. Role Details</h2><div class="role-fields">
   <div id="role-template-field" hidden><label for="role-template">Select Role Template *</label><select id="role-template" class="form-select"></select><a href="/Admin/Roles/Templates">Manage Role Templates</a></div>
   <div><label for="role-name">Role Name *</label><input id="role-name" class="form-control" required minlength="2" maxlength="50" placeholder="e.g. Cashier"/><small class="roles-help">Defaults to the selected template name; change it if needed.</small></div>
   <div><label for="role-account-type">Staff account compatibility *</label><select id="role-account-type" class="form-select"><option value="EMPLOYEE">Employee</option><option value="SHOP_ADMIN">Shop Admin</option></select><small class="roles-help">Only the owner can classify Shop Admin roles. Create a new role to change compatibility after staff are assigned.</small></div>
   <div><details class="role-copy-advanced"><summary>Advanced: Copy an existing role</summary><label for="role-copy">Copy Permissions From</label><select id="role-copy" class="form-select"><option value="">Start with no permissions</option></select></details></div>
   <div><label for="role-description">Description (optional)</label><input id="role-description" class="form-control" maxlength="200" placeholder="e.g. Handles billing and customer payments"/></div>
   <fieldset class="role-status-choices"><legend>Status</legend><label><input type="radio" name="roleStatus" value="ACTIVE" checked/> Active</label><label><input type="radio" name="roleStatus" value="INACTIVE"/> Inactive</label></fieldset>
  </div><p id="role-impact" class="role-impact" hidden></p>
  </section>
  <section id="role-template-preview" class="role-template-preview" hidden><h2>Default Module Access</h2><p id="role-template-note"></p><p id="role-template-limits" class="roles-help"></p><div id="role-template-modules" class="role-template-modules"></div><label class="role-customize-choice"><input id="role-customize" type="checkbox"/> Customize module permissions</label><p class="roles-help">Preview only. Permissions are saved when you save this role. Shop access is assigned separately during user registration.</p></section>
  <section class="role-card role-permission-card"><div class="role-section-heading"><h2><svg aria-hidden="true"><use href="/images/icons.svg#shield"/></svg>2. Role Permissions</h2><p>Tick a module to select all its screens and actions. You can untick individual screens or actions.</p></div><div class="role-permission-layout"><div id="role-permission-matrix"></div></div></section>
  <section class="role-card"><h2><svg aria-hidden="true"><use href="/images/icons.svg#document"/></svg>3. Access Summary</h2><div class="role-access-summary"><strong>Selected permissions: <span id="role-permission-count">0</span></strong><p>This role controls allowed tasks. Shop access is assigned separately during user registration.</p><p>Linked staff follow saved role changes. Existing custom accounts retain their individual grants until their role changes.</p></div></section>
  <footer class="role-form-footer"><button id="role-reset" type="button" class="btn btn-outline-secondary">Reset unsaved changes</button><a class="btn btn-outline-secondary" href="/Admin/Roles">Cancel</a><button id="role-save" type="submit" class="btn btn-primary">Save Role</button></footer>
 </form>
</div>
