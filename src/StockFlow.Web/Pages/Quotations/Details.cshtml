@page
@{ViewData["Title"]="Quotation Details";}
<div id="quotations" data-mode="details">
<header class="sf-page-heading"><div><h1 id="quotation-title">Quotation</h1><p id="quotation-status"></p></div><a href="/Quotations" class="btn btn-outline-secondary">Back to Quotations</a></header>
<div id="quotation-message" class="alert alert-danger" role="alert" hidden></div>
<div class="card card-body"><div class="d-flex flex-wrap gap-2"><label>Revision<select id="quotation-revisions" class="form-select"></select></label><a id="quotation-print" class="btn btn-outline-secondary">Preview / Print / Save PDF</a><a id="quotation-edit" class="btn btn-primary">Create Revision</a><a id="quotation-convert" class="btn btn-primary">Open in New Sale</a><a id="quotation-invoice" class="btn btn-outline-secondary" hidden>View Final Invoice</a></div><p id="quotation-customer-detail"></p><div class="table-responsive"><table class="table"><thead><tr><th>Product / SKU</th><th>Qty / Unit</th><th>MRP</th><th>Price</th><th>Discount</th><th>Tax %</th><th>Amount</th></tr></thead><tbody id="quotation-details-lines"></tbody></table></div><div id="quotation-detail-summary"></div><p id="quotation-terms-detail" class="quote-preserve"></p></div>
<form id="quotation-state-form" class="card card-body mt-3"><h2>Record customer decision</h2><p>Sent records your confirmed manual sharing action. This screen does not send a message.</p><label>Action<select id="quotation-state" class="form-select"></select></label><label>Confirmation / reason<textarea id="quotation-state-notes" class="form-control" required minlength="3" maxlength="1000" rows="2"></textarea></label><button class="btn btn-primary mt-2">Record Decision</button></form>
<section class="card card-body mt-3"><h2>Quotation History</h2><div id="quotation-history"></div></section>
</div>
@section Scripts {<script src="~/js/sales-common.js" asp-append-version="true"></script><script src="~/js/quotations.js" asp-append-version="true"></script>}
@section Styles {<link rel="stylesheet" href="~/css/quotations.css" asp-append-version="true" />}
