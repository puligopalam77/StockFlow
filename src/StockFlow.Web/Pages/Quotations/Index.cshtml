@page
@{ViewData["Title"]="Quotations & Estimates";}
<div id="quotations" data-mode="list" data-sf-pagination-remote="true" data-can-sale-view="@Access.Can("SALES","VIEW").ToString().ToLowerInvariant()">
<header class="sf-page-heading quote-list-heading"><div><h1>Quotations &amp; Estimates</h1><p>Manage customer estimates, revisions and conversions.</p></div><a href="/Quotations/Create" id="quote-new" class="btn quote-list-primary" permission-module="QUOTATIONS" permission-action="CREATE">+ New Quotation</a></header>
<div id="quotation-message" role="alert" class="alert alert-danger" hidden></div>
<form id="quotation-filters" class="sf-filter-bar quote-list-filters" novalidate>
<label for="quote-search">Search<input id="quote-search" type="search" class="form-control" maxlength="150" placeholder="Search quotation no., customer or mobile" /></label>
<label for="quote-status">Status<select id="quote-status" class="form-select"><option value="">All Statuses</option>@foreach(var s in new[]{"DRAFT","SENT","ACCEPTED","REJECTED","EXPIRED","CONVERTED","CANCELLED"}){<option value="@s">@(char.ToUpper(s[0])+s[1..].ToLowerInvariant())</option>}</select></label>
<label for="quote-from">Date From<input id="quote-from" type="date" min="2000-01-01" max="2100-12-31" class="form-control" /></label><label for="quote-to">Date To<input id="quote-to" type="date" min="2000-01-01" max="2100-12-31" class="form-control" /></label><button id="quote-reset" type="button" class="btn btn-outline-secondary">Reset Filters</button><p id="quote-filter-error" role="alert" class="quote-list-error" hidden></p>
</form>
<section class="card quote-list-card" aria-label="Saved quotations">
<div class="quote-list-toolbar"><span id="quote-list-status" role="status" aria-live="polite"></span><a id="quote-export" class="btn btn-outline-secondary" permission-module="QUOTATIONS" permission-action="EXPORT" aria-disabled="true">Export CSV</a></div>
<div id="quote-list-error" class="quote-list-state" role="alert" hidden><strong>Unable to load quotations</strong><p id="quote-list-error-text"></p><button type="button" id="quote-retry" class="btn btn-dark">Retry</button></div>
<div id="quote-list-empty" class="quote-list-state" hidden><svg class="sf-icon" aria-hidden="true"><use href="/images/icons.svg#document" /></svg><h2 id="quote-empty-title"></h2><p id="quote-empty-text"></p><button type="button" id="quote-empty-reset" class="btn btn-outline-secondary" hidden>Reset Filters</button></div>
<div id="quote-list-table" class="table-responsive quote-list-scroll" tabindex="0" role="region" aria-label="Saved quotations, scroll horizontally for all columns" hidden><table class="table quote-list-table"><thead><tr><th>Quotation</th><th>Customer</th><th>Date</th><th>Valid Until</th><th>Items</th><th>Estimated Total</th><th>Status</th><th>Actions</th></tr></thead><tbody id="quotation-rows"></tbody></table></div>
<footer class="quote-list-footer"><span id="quote-count" role="status"></span><div id="quote-pagination"></div></footer>
</section></div>
@section Scripts {<script src="~/js/sales-common.js" asp-append-version="true"></script><script src="~/js/quotation-list.js" asp-append-version="true"></script><script src="~/js/quotations.js" asp-append-version="true"></script>}
@section Styles {<link rel="stylesheet" href="~/css/quotations.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/quotation-list.css" asp-append-version="true" />}
