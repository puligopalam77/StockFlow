@page "/Replenishment"
@model StockFlow.Web.Pages.Replenishment.IndexModel
@inject StockFlow.Application.Common.BusinessScope Scope
@{ViewData["Title"]="Replenishment Planning";}
@section PageHeader {
<header class="sf-page-heading"><div><div class="rp-heading-title"><h1>Replenishment Planning</h1><button type="button" id="rp-help-open" class="rp-help-open" popovertarget="rp-help" aria-label="How Replenishment Planning Works">?</button></div><p>Plan stock purchases using sales demand, supplier lead times and incoming supply.</p><small>Location: @Scope.LocationName</small></div>
@if(Access.Can("PURCHASES","VIEW")){<a class="btn btn-outline-secondary" href="/Purchases">Review Draft Purchase Orders</a>}</header>}
<div id="replenishment" data-edit="@((Scope.IsOwner&&Access.Can("REPLENISHMENT","POLICY_EDIT")).ToString().ToLowerInvariant())" data-configure-supplier="@((Scope.CatalogRegistrationEnhancementsAvailable&&Access.Can("PRODUCTS","EDIT")&&Access.Can("PRODUCT_VARIANTS","EDIT")&&Access.Can("SUPPLIERS","VIEW")).ToString().ToLowerInvariant())" data-prepare="@((Access.Can("REPLENISHMENT","PREPARE_PO")&&Access.Can("PURCHASES","CREATE")).ToString().ToLowerInvariant())" data-export="@Access.Can("REPLENISHMENT","EXPORT").ToString().ToLowerInvariant()" data-sf-pagination-remote="true">
<aside id="rp-help" popover="auto" class="rp-help" aria-labelledby="rp-help-title" tabindex="-1"><h2 id="rp-help-title">How Replenishment Planning Works</h2><p>Recommendations are advisory. Lead times are owner-configured estimates; historical demand does not guarantee future sales.</p><p>Draft POs are excluded from incoming supply. Remaining partially received orders and dispatched transfers have no verified arrival dates.</p><p>Viewing plans and editing policies post no stock or money. Draft preparation uses the existing purchase workflow; purchasing and receiving remain under human control.</p><button type="button" class="btn btn-outline-secondary" popovertarget="rp-help" popovertargetaction="hide">Close help</button></aside>
<div class="rp-metrics" aria-label="Filtered replenishment summary">@foreach(var m in new[]{("review","Variants Requiring Review","Need planning attention","box"),("risk","Estimated Shortage Risk","Flagged by configured policy","report-warning"),("suggested","Suggested Units to Order","Planning recommendation","cart"),("incoming","Eligible Incoming Units","Eligible open supply","in")}){<section class="rp-kpi rp-kpi-@m.Item1"><span class="rp-kpi-icon"><svg class="sf-icon" aria-hidden="true"><use href="@($"/images/icons.svg#{m.Item4}")" /></svg></span><h2>@m.Item2</h2><strong id="rp-@m.Item1">—</strong><p id="rp-@m.Item1-description">@m.Item3</p></section>}</div>
<p id="rp-uncertainty" class="rp-note" role="status" hidden></p>
<form id="rp-filters"><label>Search<input id="rp-term" maxlength="150" placeholder="Search product, variant or SKU" /></label><label>Status<select id="rp-status"><option value="">All statuses</option></select></label><label>Demand lookback<select id="rp-days"><option value="7">Last 7 Days</option><option value="30" selected>Last 30 Days</option><option value="60">Last 60 Days</option><option value="90">Last 90 Days</option></select></label><label>Supplier<select id="rp-supplier"><option value="">All suppliers</option></select></label><button type="button" id="rp-reset" class="btn btn-outline-secondary">Reset Filters</button><button type="button" id="rp-export" class="btn btn-outline-secondary" hidden disabled>Export CSV</button><button type="button" id="rp-prepare" class="btn rp-primary" hidden disabled>Prepare Draft PO (0)</button></form>
<section class="rp-results"><p id="rp-message" role="status" aria-live="polite"></p><button type="button" id="rp-retry" class="btn btn-outline-secondary" hidden>Retry</button><div class="rp-scroll" tabindex="0" role="region" aria-label="Replenishment variants; scroll for all columns"><table><thead><tr><th>Select</th><th>Product / Variant</th><th>SKU</th><th>Ledger Stock</th><th>Avg Daily Demand<small>Units/day</small></th><th>Estimated Cover</th><th>Lead Days</th><th>Incoming</th><th>Suggested</th><th>Status</th><th>Actions</th></tr></thead><tbody id="rp-rows"></tbody></table></div><div id="rp-pagination"></div></section>
<dialog data-sf-dialog="large" id="rp-detail" class="rp-calculation" aria-labelledby="rp-detail-title" aria-describedby="rp-detail-subtitle">
<header class="rp-calculation-header"><div><h2 id="rp-detail-title">Replenishment Calculation</h2><p id="rp-detail-subtitle">How StockFlow calculated this recommendation</p><strong id="rp-detail-product"></strong><p id="rp-detail-identity"></p><small>Location: @Scope.LocationName</small></div><button type="button" class="btn btn-dark rp-calculation-close" aria-label="Close calculation details" data-close autofocus>&times;</button></header>
<div id="rp-explanation" class="rp-calculation-body" tabindex="0" role="region" aria-label="Calculation information"></div>
<footer class="rp-calculation-footer"><small id="rp-detail-snapshot"></small><div><button type="button" id="rp-detail-policy" class="btn rp-primary" hidden>Configure Policy</button><button type="button" class="btn btn-outline-secondary" data-close>Close</button></div></footer>
</dialog>
<dialog data-sf-dialog="medium" id="rp-policy" aria-labelledby="rp-policy-title"><form id="rp-policy-form"><h2 id="rp-policy-title">Planning policy</h2><p>Owner-configured settings; observed delivery lead time is not available.</p><a id="rp-policy-configure" class="btn btn-outline-secondary" hidden>Configure Supplier in Product Edit</a><p id="rp-policy-setup-help" class="rp-note"></p><label>Mapped supplier<select id="rp-policy-supplier" required></select></label><label>Lead time (days)<input id="rp-lead" type="number" min="0" max="365" required /></label><label>Safety stock (units)<input id="rp-safety" type="number" min="0" max="1000000" required /></label><label>Desired coverage (days)<input id="rp-coverage" type="number" min="1" max="365" required /></label><label>Minimum order quantity<input id="rp-moq" type="number" min="1" max="1000000" required /></label><label>Order multiple (stock units)<input id="rp-multiple" type="number" min="1" max="10000" required /></label><p>No policy values are saved until you confirm. These units do not change receiving pack conversions or Low Stock minimums.</p><button class="btn rp-primary">Save Policy</button><button type="button" class="btn btn-outline-secondary" data-close>Cancel</button><p class="rp-error" role="alert"></p></form></dialog>
<dialog data-sf-dialog="workflow" id="rp-draft" aria-labelledby="rp-draft-title"><form id="rp-draft-form"><h2 id="rp-draft-title">Review draft Purchase Order</h2><p>One mapped supplier per draft. Enter current prices and applicable tax; historical prices are not supplier quotes. This creates an editable draft only.</p><div id="rp-draft-lines"></div><button class="btn rp-primary">Create Draft for Review</button><button type="button" class="btn btn-outline-secondary" data-close>Cancel</button><p class="rp-error" role="alert"></p><div id="rp-draft-result" role="status"></div></form></dialog>
</div>
@section Styles{<link rel="stylesheet" href="~/css/replenishment.css" asp-append-version="true" />}
@section Scripts{<script src="~/js/supplier-navigation.js" asp-append-version="true"></script><script src="~/js/replenishment.js" asp-append-version="true"></script>}
